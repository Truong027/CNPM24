        <mxCell id="uc02_resident_login_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Mật khẩu chính xác &amp; status == 'active' &amp; role == 'Resident']" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=310;height=26;dashed=1;dashPattern=8 4;strokeColor=#4338CA;fillColor=#EEF2FF;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#1E1B4B;" vertex="1">
          <mxGeometry x="680" y="448" width="810" height="308" as="geometry" />
        </mxCell>
        <mxCell id="uc02_resident_login_msg_happy_1" parent="1" value="5a. Khởi tạo session['user'] = {id, role: 'Resident', username}" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
