          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_msg_init_4" parent="1" value="4. Trả về thông tin người dùng và mã băm password_hash" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
