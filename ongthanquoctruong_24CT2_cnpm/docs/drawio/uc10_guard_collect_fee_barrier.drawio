          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_msg_happy_3" parent="1" value="5a. Xác nhận ghi nhận doanh thu và kết thúc phiên gửi xe" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1244" y="503" as="sourcePoint" />
