        <mxCell id="uc10_guard_collect_fee_barrier_msg_else_1" parent="1" value="3b. Giữ nguyên trạng thái Barrier đóng &amp; Bật cảnh báo giao dịch chưa hoàn tất" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
