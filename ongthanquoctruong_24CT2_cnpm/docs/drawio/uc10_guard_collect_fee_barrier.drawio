            <mxPoint x="354" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_msg_init_2" parent="1" value="2. POST /api/guard/collect_fee (session_id: 105, amount: 20000, method: 'Cash')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="366" y="282" as="sourcePoint" />
            <mxPoint x="724" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_msg_happy_1" parent="1" value="3a. UPDATE parking_sessions SET status = 'Completed', check_out_time = NOW(), fee = 20000" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="399" as="sourcePoint" />
            <mxPoint x="1244" y="399" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_msg_happy_2" parent="1" value="4a. INSERT INTO hoa_don (MaPhien, SoTien, HinhThucThanhToan, NgayLap)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
