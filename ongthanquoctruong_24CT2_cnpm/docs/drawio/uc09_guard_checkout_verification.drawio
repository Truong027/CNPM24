        <mxCell id="uc09_guard_checkout_verification_msg_init_1" parent="1" value="1. Xe ra đến cổng, Camera đọc biển số hoặc Bảo vệ chọn xe kiểm tra" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
