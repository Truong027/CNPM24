        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_init_2" parent="1" value="2. GET /api/guard/verification/51G-123.45" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
