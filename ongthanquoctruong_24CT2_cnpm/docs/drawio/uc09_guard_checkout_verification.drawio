        <mxCell id="uc09_guard_checkout_verification_actor_icon" parent="1" value="&lt;b&gt;TÁC NHÂN&lt;/b&gt;&lt;br/&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;Nhân Viên Bảo Vệ&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;(Security Guard)&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=center;" vertex="1">
