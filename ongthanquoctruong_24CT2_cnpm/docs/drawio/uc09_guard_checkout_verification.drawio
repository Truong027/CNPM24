          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_ll_ui" parent="1" value="&lt;b&gt;GIAO DIỆN&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;fe/templates/index.html&lt;br/&gt;(Bàn trực #guard-station-page, checkGuardLiveEvent)&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="380" y="60" width="240" height="840" as="geometry" />
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_ll_sys" parent="1" value="&lt;b&gt;HỆ THỐNG&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code / Hàm]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;be/app.py: GET /api/guard/verification/&lt;plate&gt;&lt;br/&gt;be/database.py: get_guard_verification_info()&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="710" y="60" width="260" height="840" as="geometry" />
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_ll_db" parent="1" value="&lt;b&gt;CƠ SỞ DỮ LIỆU&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[db / Bảng]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;HTTT_QuanLyBaiXe_AI /&lt;br/&gt;vehicles, parking_sessions, bai_do&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="1050" y="60" width="240" height="840" as="geometry" />
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_init_1" parent="1" value="1. Xe ra đến cổng, Camera đọc biển số hoặc Bảo vệ chọn xe kiểm tra" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="200" as="sourcePoint" />
            <mxPoint x="500" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_init_2" parent="1" value="2. GET /api/guard/verification/51G-123.45" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="250" as="sourcePoint" />
            <mxPoint x="840" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_init_3" parent="1" value="3. Truy vấn phiên đỗ: SELECT * FROM parking_sessions WHERE plate_text = %s AND status = 'Parked'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="300" as="sourcePoint" />
            <mxPoint x="1170" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_init_4" parent="1" value="4. Truy vấn phân loại xe: SELECT group_type, monthly_ticket_expiry FROM vehicles WHERE plate_text = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="350" as="sourcePoint" />
            <mxPoint x="1170" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_init_5" parent="1" value="5. Trả về dữ liệu phiên vào, ảnh snapshot vào, nhóm đối tượng, hạn vé tháng" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="400" as="sourcePoint" />
            <mxPoint x="840" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Trường hợp 1: Xe Cư dân vé tháng còn hiệu lực (monthly_ticket_expiry &gt;= NOW)]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=340;height=26;dashed=1;dashPattern=8 4;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#0F172A;" vertex="1">
          <mxGeometry x="90" y="460" width="1200" height="400" as="geometry" />
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_happy_1" parent="1" value="6a. Xác nhận miễn phí gửi xe (fee = 0đ) theo chính sách vé tháng cư dân" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="495" as="sourcePoint" />
            <mxPoint x="840" y="515" as="targetPoint" />
            <Array as="points">
              <mxPoint x="885" y="495" />
              <mxPoint x="885" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_happy_2" parent="1" value="7a. Phản hồi HTTP 200 {is_resident: true, fee: 0, status: 'Valid'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="545" as="sourcePoint" />
            <mxPoint x="500" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_happy_3" parent="1" value="8a. Hiển thị badge xanh 'VÉ THÁNG HỢP LỆ' &amp; So sánh khớp ảnh Vào - Ra" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="595" as="sourcePoint" />
            <mxPoint x="170" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_alt_divider" parent="1" value="&lt;b&gt;[else: Trường hợp 2: Xe thuộc Danh Sách Đen (group_type == 'Blacklist' / Cảnh báo trộm cắp)]&lt;/b&gt;" style="html=1;strokeWidth=1.5;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=15;fontColor=#B91C1C;fontSize=11;fontStyle=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="660" as="sourcePoint" />
            <mxPoint x="1290" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_else_1" parent="1" value="6b. Bật cờ cảnh báo an ninh khẩn cấp (security_alert = True, lock_barrier = True)" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="690" as="sourcePoint" />
            <mxPoint x="840" y="710" as="targetPoint" />
            <Array as="points">
              <mxPoint x="885" y="690" />
              <mxPoint x="885" y="710" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_else_2" parent="1" value="7b. Phản hồi HTTP 200 {is_blacklist: true, alert_level: 'HIGH', fee: 0}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="740" as="sourcePoint" />
            <mxPoint x="500" y="740" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_else_3" parent="1" value="8b. Khóa nút mở barrier, nhấp nháy đèn đỏ CẢNH BÁO XE GIAN LẬN/TRỘM CẮP &amp; Báo động" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#B91C1C;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
