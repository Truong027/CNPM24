              <mxPoint x="781" y="682" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_post_1" parent="1" value="7. Phản hồi thông tin đối chiếu (Khớp vé tháng hoặc Cảnh báo an ninh Blacklist)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="724" y="769" as="sourcePoint" />
