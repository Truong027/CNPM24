          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_init_3" parent="1" value="3. Truy vấn phiên đỗ: SELECT * FROM parking_sessions WHERE plate_text = %s AND status = 'Parked'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="334" as="sourcePoint" />
            <mxPoint x="1330" y="334" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_init_4" parent="1" value="4. Truy vấn phân loại xe: SELECT group_type, monthly_ticket_expiry FROM vehicles WHERE plate_text = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="386" as="sourcePoint" />
            <mxPoint x="1330" y="386" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_guard_checkout_verification_msg_init_5" parent="1" value="5. Trả về dữ liệu phiên vào, ảnh snapshot vào, nhóm đối tượng, hạn vé tháng" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
