        <mxCell id="uc09_guard_checkout_verification_alt_cond_label" parent="1" value="&lt;b&gt;&lt;font color='#4338CA' style='font-size: 11px;'&gt;🔍 [ĐIỀU KIỆN KIỂM TRA]:&lt;/font&gt;&lt;/b&gt; &lt;font color='#0F172A' style='font-size: 11px;'&gt;Kiểm tra thời hạn vé tháng &amp; Cảnh báo an ninh Blacklist&lt;/font&gt;&lt;br/&gt;&lt;b&gt;&lt;font color='#15803D' style='font-size: 10.5px;'&gt;✓ [Trường hợp hợp lệ]:&lt;/font&gt;&lt;/b&gt; &lt;font color='#166534' style='font-size: 10.5px;'&gt;Trường hợp 1: Xe Cư dân vé tháng còn hiệu lực (monthly_ticket_expiry &gt;= NOW)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1">
