<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-10-16T00:00:00.000Z" agent="GitHub-Copilot" version="24.7.17" type="device">
  <diagram id="complete-login-flow" name="Chức năng đăng nhập hoàn chỉnh">
    <mxGraphModel dx="1500" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;SƠ ĐỒ LUỒNG XỬ LÝ CHỨC NĂNG ĐĂNG NHẬP&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;fe/templates/login.html → be/app.py → database.py → session&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="840" height="55" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;START&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=15;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="640" y="105" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="open" value="&lt;b&gt;Mở trang đăng nhập&lt;/b&gt;&lt;br/&gt;GET `/login`&lt;br/&gt;Render `fe/templates/login.html`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="535" y="215" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;b&gt;Nhập số điện thoại và mật khẩu&lt;/b&gt;&lt;br/&gt;Bấm nút Đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=13;fontColor=#0C4A6E;" vertex="1" parent="1"><mxGeometry x="535" y="350" width="430" height="75" as="geometry"/></mxCell>
        <mxCell id="validate" value="&lt;b&gt;Kiểm tra dữ liệu đầu vào&lt;/b&gt;&lt;br/&gt;Có đủ phone/username và password?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=13;fontColor=#581C87;" vertex="1" parent="1"><mxGeometry x="565" y="475" width="370" height="105" as="geometry"/></mxCell>
        <mxCell id="input-error" value="&lt;b&gt;Báo lỗi form&lt;/b&gt;&lt;br/&gt;Thiếu số điện thoại hoặc mật khẩu&lt;br/&gt;Giữ nguyên form để nhập lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="80" y="485" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;Gửi yêu cầu đăng nhập&lt;/b&gt;&lt;br/&gt;POST `/api/login`&lt;br/&gt;`be/app.py: api_login()`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="535" y="635" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="db-check" value="&lt;b&gt;Xác thực tài khoản&lt;/b&gt;&lt;br/&gt;`database.authenticate_user()`&lt;br/&gt;Đọc app_users và kiểm tra mật khẩu hash, trạng thái active" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;fontSize=12;fontColor=#581C87;" vertex="1" parent="1"><mxGeometry x="520" y="780" width="460" height="115" as="geometry"/></mxCell>
        <mxCell id="auth-result" value="&lt;b&gt;Tài khoản hợp lệ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=13;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="575" y="950" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="fail" value="&lt;b&gt;Đăng nhập thất bại&lt;/b&gt;&lt;br/&gt;HTTP 401: sai số điện thoại hoặc mật khẩu&lt;br/&gt;Quay lại form đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="70" y="950" width="365" height="90" as="geometry"/></mxCell>
        <mxCell id="session" value="&lt;b&gt;Tạo session người dùng&lt;/b&gt;&lt;br/&gt;Lưu id, username, full_name, role&lt;br/&gt;Trả JSON success + redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1090" y="950" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="success" value="&lt;b&gt;Đăng nhập thành công&lt;/b&gt;&lt;br/&gt;HTTP 200, lưu session người dùng&lt;br/&gt;Trả về thông tin user và URL chuyển trang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1060" y="1080" width="405" height="90" as="geometry"/></mxCell>
        <mxCell id="role" value="&lt;b&gt;Điều hướng theo role&lt;/b&gt;&lt;br/&gt;Resident → `/resident-dashboard`&lt;br/&gt;Guard/Admin → `/`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;fontSize=12;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="1060" y="1210" width="405" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="start" target="open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="open" target="input"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="input" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Không" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#DC2626;fontColor=#991B1B;" edge="1" parent="1" source="validate" target="input-error"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Có" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#16A34A;fontColor=#166534;" edge="1" parent="1" source="validate" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#475569;" edge="1" parent="1" source="api" target="db-check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#475569;" edge="1" parent="1" source="db-check" target="auth-result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Không" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#DC2626;fontColor=#991B1B;" edge="1" parent="1" source="auth-result" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Có" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#16A34A;fontColor=#166534;" edge="1" parent="1" source="auth-result" target="session"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#475569;" edge="1" parent="1" source="session" target="success"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#475569;" edge="1" parent="1" source="success" target="role"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
