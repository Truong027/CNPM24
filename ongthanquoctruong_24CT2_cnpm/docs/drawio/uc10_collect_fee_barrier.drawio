        <mxCell id="uc10_collect_fee_barrier_msg_1" parent="1" value="1. Bảo vệ xác nhận thu tiền mặt/QR và bấm 'Xác Nhận Thu Phí &amp; Mở Barrier'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="200" as="sourcePoint" />
            <mxPoint x="475" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_collect_fee_barrier_msg_2" parent="1" value="2. POST /api/guard/collect_fee (session_id: 105, amount: 20000, method: 'Cash')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="475" y="255" as="sourcePoint" />
            <mxPoint x="820" y="255" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_collect_fee_barrier_msg_3" parent="1" value="3. UPDATE parking_sessions SET status = 'Completed', check_out_time = NOW(), fee = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="310" as="sourcePoint" />
            <mxPoint x="1160" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_collect_fee_barrier_msg_4" parent="1" value="4. UPDATE lich_su_ra_vao SET ThoiGianRa = NOW(), TrangThai = 'DaThanhToan'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="365" as="sourcePoint" />
            <mxPoint x="1160" y="365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_collect_fee_barrier_msg_5" parent="1" value="5. Trả về kết quả cập nhật thành công" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
