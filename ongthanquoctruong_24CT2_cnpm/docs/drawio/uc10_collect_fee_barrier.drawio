        <mxCell id="uc10_collect_fee_barrier_msg_8" parent="1" value="8. In hóa đơn điện tử, bật thông báo 'Cho xe qua cổng' &amp; Cổng Barrier nâng lên" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
