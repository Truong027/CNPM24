        <mxCell id="uc10_collect_fee_barrier_ll_ui" parent="1" value="&lt;b&gt;GIAO DIỆN&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;fe/templates/index.html&lt;br/&gt;(#guardFeeBox, #guardConfirmActionBtn)&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
