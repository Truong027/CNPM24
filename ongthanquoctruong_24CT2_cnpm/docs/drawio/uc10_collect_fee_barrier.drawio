          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_collect_fee_barrier_msg_6" parent="1" value="6. Kích hoạt tín hiệu mở Barrier (barrier_state = 'OPEN')" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;" edge="1">
