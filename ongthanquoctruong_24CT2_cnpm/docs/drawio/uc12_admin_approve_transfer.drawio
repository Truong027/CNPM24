        <mxCell id="uc12_admin_approve_transfer_msg_9" parent="1" value="9. Chuyển trạng thái đơn thành 'Đã Duyệt' &amp; Cập nhật danh mục xe" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
