        <mxCell id="uc12_admin_approve_transfer_msg_init_1" parent="1" value="1. Xem chi tiết đơn chuyển nhượng đang chờ duyệt &amp; Bấm nút quyết định" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="230" as="sourcePoint" />
            <mxPoint x="460" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_init_2" parent="1" value="2. POST /api/admin/transfer_requests/12/action (action: 'approve' / 'reject')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="282" as="sourcePoint" />
            <mxPoint x="920" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_init_3" parent="1" value="3. Lấy thông tin đơn: SELECT * FROM chuyen_nhuong_xe WHERE MaYeuCau = 12" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="334" as="sourcePoint" />
            <mxPoint x="1330" y="334" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_init_4" parent="1" value="4. Trả về thông tin: Biển số xe, Cư dân chuyển, Cư dân nhận" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1330" y="386" as="sourcePoint" />
            <mxPoint x="920" y="386" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Admin bấm 'Phê Duyệt' (action == 'approve')]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=310;height=26;dashed=1;dashPattern=8 4;strokeColor=#4338CA;fillColor=#EEF2FF;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#1E1B4B;" vertex="1">
          <mxGeometry x="680" y="448" width="810" height="360" as="geometry" />
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_happy_1" parent="1" value="5a. TRANSACTION: UPDATE phuong_tien &amp; vehicles SET MaCuDan = NguoiNhan WHERE BienSoXe = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="483" as="sourcePoint" />
            <mxPoint x="1330" y="483" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_happy_2" parent="1" value="6a. UPDATE chuyen_nhuong_xe SET TrangThai = 'DaDuyet', NgayDuyet = NOW()" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="535" as="sourcePoint" />
            <mxPoint x="1330" y="535" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_happy_3" parent="1" value="7a. Commit transaction chuyển nhượng thành công" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1330" y="587" as="sourcePoint" />
            <mxPoint x="920" y="587" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_alt_divider" parent="1" value="&lt;b&gt;[else: Admin bấm 'Từ Chối' (action == 'reject')]&lt;/b&gt;" style="html=1;strokeWidth=1.5;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=15;fontColor=#B91C1C;fontSize=11;fontStyle=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="654" as="sourcePoint" />
            <mxPoint x="1490" y="654" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_else_1" parent="1" value="5b. UPDATE chuyen_nhuong_xe SET TrangThai = 'TuChoi', LyDo = 'Thông tin không chính xác'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#B91C1C;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="684" as="sourcePoint" />
            <mxPoint x="1330" y="684" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_else_2" parent="1" value="6b. Xác nhận cập nhật trạng thái từ chối đơn" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1330" y="736" as="sourcePoint" />
            <mxPoint x="920" y="736" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_post_1" parent="1" value="8. Phản hồi thông báo kết quả phê duyệt / từ chối" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="843" as="sourcePoint" />
            <mxPoint x="460" y="843" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_post_2" parent="1" value="9. Đổi huy hiệu đơn (Màu xanh 'ĐÃ DUYỆT' hoặc Màu đỏ 'ĐÃ TỪ CHỐI') &amp; Cập nhật danh mục xe" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
