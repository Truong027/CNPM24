        <mxCell id="uc12_admin_approve_transfer_title" parent="1" value="&lt;b&gt;3.2. SƠ ĐỒ TUẦN TỰ (SEQUENCE DIAGRAM): [ADMIN] UC12 - PHÊ DUYỆT ĐƠN CHUYỂN NHƯỢNG XE &amp; Ô ĐỖ&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontColor=#1E293B;fontStyle=1;" vertex="1">
          <mxGeometry x="50" y="15" width="1280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_actor_icon" parent="1" value="&lt;b&gt;TÁC NHÂN&lt;/b&gt;&lt;br/&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;Quản Trị Viên&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;(System Admin)&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=center;" vertex="1">
          <mxGeometry x="140" y="60" width="60" height="65" as="geometry" />
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_ll_actor" parent="1" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#1D4ED8;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="165" as="sourcePoint" />
            <mxPoint x="170" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_ll_ui" parent="1" value="&lt;b&gt;GIAO DIỆN&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;fe/templates/index.html&lt;br/&gt;(Trang chuyển nhượng #transfers-page)&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="380" y="60" width="240" height="940" as="geometry" />
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_ll_sys" parent="1" value="&lt;b&gt;HỆ THỐNG&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code / Hàm]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;be/app.py: POST /api/admin/transfer_requests/&lt;id&gt;/action&lt;br/&gt;be/database.py: process_transfer_request_action()&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="710" y="60" width="260" height="940" as="geometry" />
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_ll_db" parent="1" value="&lt;b&gt;CƠ SỞ DỮ LIỆU&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[db / Bảng]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;HTTT_QuanLyBaiXe_AI /&lt;br/&gt;chuyen_nhuong_xe, vehicles, phuong_tien&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="1050" y="60" width="240" height="940" as="geometry" />
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_init_1" parent="1" value="1. Xem chi tiết đơn chuyển nhượng đang chờ duyệt &amp; Bấm nút quyết định" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="200" as="sourcePoint" />
            <mxPoint x="500" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_init_2" parent="1" value="2. POST /api/admin/transfer_requests/12/action (action: 'approve' / 'reject')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="250" as="sourcePoint" />
            <mxPoint x="840" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_init_3" parent="1" value="3. Lấy thông tin đơn: SELECT * FROM chuyen_nhuong_xe WHERE MaYeuCau = 12" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="300" as="sourcePoint" />
            <mxPoint x="1170" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_init_4" parent="1" value="4. Trả về thông tin: Biển số xe, Cư dân chuyển, Cư dân nhận" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="350" as="sourcePoint" />
            <mxPoint x="840" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Admin bấm 'Phê Duyệt' (action == 'approve')]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=340;height=26;dashed=1;dashPattern=8 4;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#0F172A;" vertex="1">
          <mxGeometry x="90" y="410" width="1200" height="550" as="geometry" />
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_happy_1" parent="1" value="5a. TRANSACTION: UPDATE phuong_tien &amp; vehicles SET MaCuDan = NguoiNhan WHERE BienSoXe = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="445" as="sourcePoint" />
            <mxPoint x="1170" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_happy_2" parent="1" value="6a. UPDATE chuyen_nhuong_xe SET TrangThai = 'DaDuyet', NgayDuyet = NOW()" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="495" as="sourcePoint" />
            <mxPoint x="1170" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_happy_3" parent="1" value="7a. Commit transaction chuyển nhượng thành công" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="545" as="sourcePoint" />
            <mxPoint x="840" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_happy_4" parent="1" value="8a. Phản hồi HTTP 200 {success: true, message: 'Đã chuyển nhượng xe sang chủ sở hữu mới'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="595" as="sourcePoint" />
            <mxPoint x="500" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_happy_5" parent="1" value="9a. Đổi huy hiệu đơn sang màu xanh 'ĐÃ DUYỆT' &amp; Cập nhật danh mục xe" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="645" as="sourcePoint" />
            <mxPoint x="170" y="645" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_alt_divider" parent="1" value="&lt;b&gt;[else: Admin bấm 'Từ Chối' (action == 'reject')]&lt;/b&gt;" style="html=1;strokeWidth=1.5;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=15;fontColor=#B91C1C;fontSize=11;fontStyle=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="710" as="sourcePoint" />
            <mxPoint x="1290" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_else_1" parent="1" value="5b. UPDATE chuyen_nhuong_xe SET TrangThai = 'TuChoi', LyDo = 'Thông tin không chính xác'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#B91C1C;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="740" as="sourcePoint" />
            <mxPoint x="1170" y="740" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_else_2" parent="1" value="6b. Xác nhận cập nhật trạng thái từ chối đơn" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="790" as="sourcePoint" />
            <mxPoint x="840" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_else_3" parent="1" value="7b. Phản hồi HTTP 200 {success: true, message: 'Đã từ chối đơn chuyển nhượng'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="840" as="sourcePoint" />
            <mxPoint x="500" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_else_4" parent="1" value="8b. Đổi huy hiệu đơn sang màu đỏ 'ĐÃ TỪ CHỐI'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#B91C1C;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="890" as="sourcePoint" />
            <mxPoint x="170" y="890" as="targetPoint" />
          </mxGeometry>
        </mxCell>
