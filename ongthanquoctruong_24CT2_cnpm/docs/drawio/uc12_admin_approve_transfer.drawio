        <mxCell id="uc12_admin_approve_transfer_ll_actor" parent="1" value="&lt;b&gt;TÁC NHÂN&lt;/b&gt;&lt;br/&gt;&lt;font color='#1E40AF'&gt;Quản Trị Viên&lt;br/&gt;(Admin)&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
