        <mxCell id="uc12_admin_approve_transfer_ll_db" parent="1" value="&lt;b&gt;CƠ SỞ DỮ LIỆU&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[db / Bảng]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 10.5px;'&gt;&lt;i&gt;HTTT_QuanLyBaiXe_AI /&lt;br/&gt;chuyen_nhuong_xe, vehicles, phuong_tien&lt;/i&gt;&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=125;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
