        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_ll_db" parent="1" value="&lt;b&gt;CƠ SỞ DỮ LIỆU&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[db / Bảng]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;HTTT_QuanLyBaiXe_AI /&lt;br/&gt;chuyen_nhuong_xe, vehicles, phuong_tien, cu_dan&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="1040" y="60" width="240" height="750" as="geometry" />
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_1" parent="1" value="1. Xem thông tin đơn chuyển nhượng đang chờ &amp; Bấm nút 'Phê Duyệt'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="200" as="sourcePoint" />
            <mxPoint x="475" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_2" parent="1" value="2. POST /api/admin/transfer_requests/12/action (action: 'approve')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="475" y="255" as="sourcePoint" />
            <mxPoint x="820" y="255" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_3" parent="1" value="3. Lấy thông tin đơn: SELECT * FROM chuyen_nhuong_xe WHERE MaYeuCau = 12" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="310" as="sourcePoint" />
            <mxPoint x="1160" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_4" parent="1" value="4. Trả về thông tin: Biển số, Người chuyển, Người nhận" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160" y="365" as="sourcePoint" />
            <mxPoint x="820" y="365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_5" parent="1" value="5. TRANSACTION: UPDATE phuong_tien &amp; vehicles SET MaCuDan = NguoiNhan" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="420" as="sourcePoint" />
            <mxPoint x="1160" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_6" parent="1" value="6. UPDATE chuyen_nhuong_xe SET TrangThai = 'DaDuyet', NgayDuyet = NOW()" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="475" as="sourcePoint" />
            <mxPoint x="1160" y="475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_7" parent="1" value="7. Commit transaction thành công" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160" y="530" as="sourcePoint" />
            <mxPoint x="820" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc12_admin_approve_transfer_msg_8" parent="1" value="8. Phản hồi JSON: {success: true, message: 'Đã chuyển nhượng xe sang chủ sở hữu mới'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
