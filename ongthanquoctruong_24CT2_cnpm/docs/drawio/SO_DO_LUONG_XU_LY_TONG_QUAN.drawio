        <mxCell id="note" value="&lt;b&gt;Ghi chú triển khai&lt;/b&gt;&lt;br/&gt;Các luồng chi tiết được mô tả trong `docs/drawio/uc01...uc13`.&lt;br/&gt;Backend chính: `be/app.py`; giao diện: `fe/templates`; dữ liệu: MySQL." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=1.5;fontSize=12;fontColor=#7C2D12;" vertex="1" parent="1">
