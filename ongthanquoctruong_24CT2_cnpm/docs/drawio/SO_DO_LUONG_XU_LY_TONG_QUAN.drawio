        <mxCell id="e4" value="Chưa đăng nhập" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;strokeWidth=1.5;strokeColor=#DC2626;fontColor=#991B1B;" edge="1" parent="1" source="session-check" target="login"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415" y="610" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="Chưa có tài khoản" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;strokeWidth=1.5;strokeColor=#DC2626;fontColor=#991B1B;" edge="1" parent="1" source="session-check" target="register"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="620" /></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="Quên mật khẩu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;strokeWidth=1.5;strokeColor=#64748B;fontColor=#334155;" edge="1" parent="1" source="login" target="forgot"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Đăng ký xong" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;strokeWidth=1.5;strokeColor=#16A34A;fontColor=#166534;" edge="1" parent="1" source="register" target="login"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Đăng nhập thành công" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;html=1;strokeWidth=2;strokeColor=#16A34A;fontColor=#166534;" edge="1" parent="1" source="login" target="role-check"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="780" /></Array></mxGeometry></mxCell>
