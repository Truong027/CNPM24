<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-10-16T00:00:00.000Z" agent="GitHub-Copilot" version="24.7.17" type="device">
  <diagram id="system-flow-overview" name="Sơ đồ luồng xử lý tổng quan">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;SƠ ĐỒ LUỒNG XỬ LÝ TỔNG QUAN HỆ THỐNG QUẢN LÝ BÃI ĐỖ XE AI&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;Từ START đến mở trang web và các luồng xử lý theo vai trò&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="960" height="55" as="geometry" />
        </mxCell>

        <mxCell id="start" value="&lt;b&gt;START&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=16;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="790" y="100" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="run-app" value="&lt;b&gt;Khởi động ứng dụng&lt;/b&gt;&lt;br/&gt;Chạy `python be/app.py`&lt;br/&gt;&lt;font color='#475569'&gt;Khởi tạo Flask, database, YOLO và OCR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=13;fontColor=#0C4A6E;" vertex="1" parent="1">
          <mxGeometry x="690" y="205" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="open-browser" value="&lt;b&gt;Mở trình duyệt&lt;/b&gt;&lt;br/&gt;Truy cập `http://127.0.0.1:5000/login`&lt;br/&gt;&lt;font color='#475569'&gt;Giao diện đăng nhập được tải&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="690" y="340" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="session-check" value="&lt;b&gt;Kiểm tra phiên đăng nhập&lt;/b&gt;&lt;br/&gt;`GET /api/session` hoặc nhập thông tin đăng nhập" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=13;fontColor=#581C87;" vertex="1" parent="1">
          <mxGeometry x="715" y="475" width="370" height="115" as="geometry" />
        </mxCell>
        <mxCell id="login" value="&lt;b&gt;Đăng nhập&lt;/b&gt;&lt;br/&gt;`POST /api/login`&lt;br/&gt;Sai thông tin: hiển thị lỗi và nhập lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="250" y="650" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="register" value="&lt;b&gt;Đăng ký tài khoản&lt;/b&gt;&lt;br/&gt;`POST /api/register`&lt;br/&gt;Thành công: chuyển sang đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="635" y="650" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="forgot" value="&lt;b&gt;Quên mật khẩu?&lt;/b&gt;&lt;br/&gt;Nhập email - OTP - mật khẩu mới" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1020" y="650" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="role-check" value="&lt;b&gt;Xác định vai trò&lt;/b&gt;&lt;br/&gt;`session['user']['role']`" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="680" y="815" width="440" height="115" as="geometry" />
        </mxCell>

        <mxCell id="admin" value="&lt;b&gt;ADMIN&lt;/b&gt;&lt;br/&gt;Trang quản trị `/`&lt;br/&gt;Quản lý người dùng và phân quyền&lt;br/&gt;Phê duyệt chuyển nhượng xe&lt;br/&gt;Xem báo cáo, doanh thu, thống kê" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="80" y="1010" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="&lt;b&gt;GUARD / BẢO VỆ&lt;/b&gt;&lt;br/&gt;Trang giám sát bãi xe `/`&lt;br/&gt;Nhận diện biển số bằng camera/OCR&lt;br/&gt;Check-in, check-out và xác minh xe&lt;br/&gt;Thu phí, điều khiển mở barrier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=13;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="680" y="1010" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="resident" value="&lt;b&gt;RESIDENT / CƯ DÂN&lt;/b&gt;&lt;br/&gt;Trang cư dân `/resident-dashboard`&lt;br/&gt;Quản lý hồ sơ và phương tiện&lt;br/&gt;Đổi chỗ, gia hạn vé, chuyển nhượng xe&lt;br/&gt;Xem lịch sử gửi xe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1010" width="440" height="145" as="geometry" />
        </mxCell>

        <mxCell id="end-admin" value="&lt;b&gt;Tiếp tục thao tác&lt;/b&gt;&lt;br/&gt;Đăng xuất `POST /api/logout`" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="190" y="1190" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="end-guard" value="&lt;b&gt;Tiếp tục thao tác&lt;/b&gt;&lt;br/&gt;Đăng xuất `POST /api/logout`" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="790" y="1190" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="end-resident" value="&lt;b&gt;Tiếp tục thao tác&lt;/b&gt;&lt;br/&gt;Đăng xuất `POST /api/logout`" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1190" width="220" height="65" as="geometry" />
        </mxCell>

