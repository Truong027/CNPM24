        <mxCell id="uc13_admin_analytics_msg_init_1" parent="1" value="1. Chọn khoảng thời gian xem báo cáo doanh thu &amp; Bấm 'Xem phân tích'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
