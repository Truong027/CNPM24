        <mxCell id="uc02b_forgot_password_msg_init_1" parent="1" value="1. Nhập địa chỉ Email đăng ký tài khoản &amp; Bấm 'Gửi mã xác thực OTP'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="96" y="230" as="sourcePoint" />
            <mxPoint x="354" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_init_2" parent="1" value="2. POST /api/forgot-password (email: 'cu_dan@example.com')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="366" y="282" as="sourcePoint" />
            <mxPoint x="724" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_init_3" parent="1" value="3. SELECT id, username FROM app_users WHERE email = %s AND status = 'active'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="334" as="sourcePoint" />
            <mxPoint x="1244" y="334" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_init_4" parent="1" value="4. Trả về kết quả tìm kiếm tài khoản theo email" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1244" y="386" as="sourcePoint" />
            <mxPoint x="736" y="386" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_happy_1" parent="1" value="5a. Sinh mã OTP ngẫu nhiên 6 chữ số (Hiệu lực trong 5 phút)" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="503" as="sourcePoint" />
            <mxPoint x="736" y="523" as="targetPoint" />
            <Array as="points">
              <mxPoint x="781" y="503" />
              <mxPoint x="781" y="523" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_happy_2" parent="1" value="6a. INSERT INTO password_reset_tokens (email, otp_hash, expires_at)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="555" as="sourcePoint" />
            <mxPoint x="1244" y="555" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_happy_3" parent="1" value="7a. Xác nhận lưu trữ mã OTP thành công" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1244" y="607" as="sourcePoint" />
            <mxPoint x="736" y="607" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_happy_4" parent="1" value="8a. Gửi Email chứa mã OTP bảo mật đến hòm thư người dùng" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="659" as="sourcePoint" />
            <mxPoint x="736" y="679" as="targetPoint" />
            <Array as="points">
              <mxPoint x="781" y="659" />
              <mxPoint x="781" y="679" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_else_1" parent="1" value="5b. Hủy yêu cầu cấp OTP &amp; Thiết lập thông báo lỗi (Email not found)" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="766" as="sourcePoint" />
