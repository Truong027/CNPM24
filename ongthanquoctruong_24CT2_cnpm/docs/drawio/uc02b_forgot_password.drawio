            <Array as="points">
              <mxPoint x="781" y="766" />
              <mxPoint x="781" y="786" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_post_1" parent="1" value="9. Phản hồi kết quả xử lý (HTTP 200 Đã gửi OTP hoặc HTTP 400 Email không tồn tại)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="724" y="873" as="sourcePoint" />
            <mxPoint x="366" y="873" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_post_2" parent="1" value="10. Chuyển sang trang reset_password.html hoặc Báo lỗi đỏ yêu cầu kiểm tra lại email" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
