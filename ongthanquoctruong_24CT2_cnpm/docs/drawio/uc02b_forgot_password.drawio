        <mxCell id="uc02b_forgot_password_msg_init_1" parent="1" value="1. Nhập địa chỉ Email đăng ký tài khoản &amp; Bấm 'Gửi mã xác thực OTP'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="121" y="230" as="sourcePoint" />
            <mxPoint x="454" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_init_2" parent="1" value="2. POST /api/forgot-password (email: 'cu_dan@example.com')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="466" y="282" as="sourcePoint" />
            <mxPoint x="914" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02b_forgot_password_msg_init_3" parent="1" value="3. SELECT id, username FROM app_users WHERE email = %s AND status = 'active'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
