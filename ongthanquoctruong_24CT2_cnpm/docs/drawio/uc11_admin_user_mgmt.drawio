          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_ll_ui" parent="1" value="&lt;b&gt;GIAO DIỆN&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;fe/templates/index.html&lt;br/&gt;(Trang quản lý #users-page, Modal #editUserModal)&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="380" y="60" width="240" height="840" as="geometry" />
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_ll_sys" parent="1" value="&lt;b&gt;HỆ THỐNG&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code / Hàm]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;be/app.py: POST /api/admin/users/update&lt;br/&gt;be/database.py: admin_update_user_info()&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="710" y="60" width="260" height="840" as="geometry" />
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_ll_db" parent="1" value="&lt;b&gt;CƠ SỞ DỮ LIỆU&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[db / Bảng]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;HTTT_QuanLyBaiXe_AI /&lt;br/&gt;app_users, cu_dan, nhan_vien&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="1050" y="60" width="240" height="840" as="geometry" />
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_init_1" parent="1" value="1. Chọn tài khoản cần chỉnh sửa, cập nhật quyền hạn/trạng thái &amp; Bấm 'Lưu thay đổi'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="200" as="sourcePoint" />
            <mxPoint x="500" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_init_2" parent="1" value="2. POST /api/admin/users/update (user_id: 5, role: 'Operator', status: 'active')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="250" as="sourcePoint" />
            <mxPoint x="840" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_init_3" parent="1" value="3. Tra cứu quyền hạn tài khoản mục tiêu: SELECT role FROM app_users WHERE id = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="300" as="sourcePoint" />
            <mxPoint x="1170" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_init_4" parent="1" value="4. Trả về thông tin vai trò hiện tại của tài khoản" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="350" as="sourcePoint" />
            <mxPoint x="840" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Thao tác hợp lệ (Không tự khóa tài khoản Root Super Admin)]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=340;height=26;dashed=1;dashPattern=8 4;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#0F172A;" vertex="1">
          <mxGeometry x="90" y="410" width="1200" height="450" as="geometry" />
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_happy_1" parent="1" value="5a. UPDATE app_users SET role = %s, status = %s WHERE id = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="445" as="sourcePoint" />
            <mxPoint x="1170" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_happy_2" parent="1" value="6a. Đồng bộ cập nhật bảng cu_dan / nhan_vien tương ứng" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="495" as="sourcePoint" />
            <mxPoint x="1170" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_happy_3" parent="1" value="7a. Xác nhận cập nhật thông tin thành công (Affected rows = 1)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="545" as="sourcePoint" />
            <mxPoint x="840" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_happy_4" parent="1" value="8a. Phản hồi HTTP 200 {success: true, message: 'Cập nhật tài khoản thành công'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="595" as="sourcePoint" />
            <mxPoint x="500" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_happy_5" parent="1" value="9a. Tải lại danh sách người dùng &amp; Hiển thị badge quyền hạn mới" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="645" as="sourcePoint" />
            <mxPoint x="170" y="645" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_alt_divider" parent="1" value="&lt;b&gt;[else: Thao tác không hợp lệ (Cố tình vô hiệu hóa tài khoản Quản trị cao nhất)]&lt;/b&gt;" style="html=1;strokeWidth=1.5;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=15;fontColor=#B91C1C;fontSize=11;fontStyle=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="710" as="sourcePoint" />
            <mxPoint x="1290" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_else_1" parent="1" value="5b. Phản hồi HTTP 403 {success: false, message: 'Không thể vô hiệu hóa tài khoản Super Admin'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="740" as="sourcePoint" />
            <mxPoint x="500" y="740" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_else_2" parent="1" value="6b. Bật cảnh báo lỗi màu đỏ 'Từ chối thao tác bảo vệ an toàn hệ thống'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#B91C1C;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
