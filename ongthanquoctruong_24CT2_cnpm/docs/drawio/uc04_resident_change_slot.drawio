        <mxCell id="uc04_resident_change_slot_ll_sys" parent="1" value="&lt;b&gt;HỆ THỐNG&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code / Hàm]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 10px; font-family: Consolas, monospace;'&gt;&lt;i&gt;D:\CNPM24CT2_OngThanQuocTruong\ongthanquoctruong_24CT2_cnpm\&lt;br/&gt;be\app.py: POST /api/parking/change_slot&lt;br/&gt;D:\CNPM24CT2_OngThanQuocTruong\ongthanquoctruong_24CT2_cnpm\&lt;br/&gt;be\database.py: change_vehicle_parking_slot()&lt;/i&gt;&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=125;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
