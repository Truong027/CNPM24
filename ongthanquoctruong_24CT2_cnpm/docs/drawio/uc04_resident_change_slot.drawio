        <mxCell id="uc04_resident_change_slot_msg_init_1" parent="1" value="1. Chọn xe cần đổi &amp; Click chọn vị trí ô trống mới (VD: B1-B05)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="230" as="sourcePoint" />
            <mxPoint x="460" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_resident_change_slot_msg_init_2" parent="1" value="2. POST /api/parking/change_slot (plate: '30H-999.88', new_slot: 'B1-B05')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="282" as="sourcePoint" />
            <mxPoint x="920" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_resident_change_slot_msg_init_3" parent="1" value="3. Tra cứu vị trí mới: SELECT TrangThai FROM bai_do WHERE MaViTri = 'B1-B05'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="334" as="sourcePoint" />
            <mxPoint x="1330" y="334" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_resident_change_slot_msg_init_4" parent="1" value="4. Trả về trạng thái của vị trí mới" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1330" y="386" as="sourcePoint" />
            <mxPoint x="920" y="386" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_resident_change_slot_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Vị trí mới còn TRỐNG (TrangThai == 'Trong')]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=310;height=26;dashed=1;dashPattern=8 4;strokeColor=#4338CA;fillColor=#EEF2FF;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#1E1B4B;" vertex="1">
          <mxGeometry x="680" y="448" width="810" height="412" as="geometry" />
        </mxCell>
        <mxCell id="uc04_resident_change_slot_msg_happy_1" parent="1" value="5a. TRANSACTION: UPDATE bai_do SET TrangThai = 'Trong', BienSoXe = NULL (Ô cũ)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="483" as="sourcePoint" />
            <mxPoint x="1330" y="483" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_resident_change_slot_msg_happy_2" parent="1" value="6a. UPDATE bai_do SET TrangThai = 'DaDat', BienSoXe = %s (Ô mới B1-B05)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="535" as="sourcePoint" />
            <mxPoint x="1330" y="535" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_resident_change_slot_msg_happy_3" parent="1" value="7a. UPDATE phuong_tien &amp; vehicles SET ViTriDo = 'B1-B05' WHERE BienSoXe = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="587" as="sourcePoint" />
            <mxPoint x="1330" y="587" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_resident_change_slot_msg_happy_4" parent="1" value="8a. Commit transaction thành công" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1330" y="639" as="sourcePoint" />
            <mxPoint x="920" y="639" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_resident_change_slot_alt_divider" parent="1" value="&lt;b&gt;[else: Vị trí mới đã bị xe khác chiếm chỗ]&lt;/b&gt;" style="html=1;strokeWidth=1.5;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=15;fontColor=#B91C1C;fontSize=11;fontStyle=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="706" as="sourcePoint" />
