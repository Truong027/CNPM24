        <mxCell id="uc04_resident_change_slot_msg_else_2" parent="1" value="6b. Thiết lập thông báo vị trí mới không khả dụng" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
