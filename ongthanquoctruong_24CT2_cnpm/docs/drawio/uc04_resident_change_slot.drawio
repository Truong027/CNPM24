        <mxCell id="uc04_resident_change_slot_msg_post_2" parent="1" value="10. Render lại sơ đồ bãi đỗ Cinema &amp; Hiển thị thông báo kết quả cho cư dân" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
