        <mxCell id="uc01_resident_register_msg_init_1" parent="1" value="1. Nhập Họ tên, SĐT, Căn hộ, Mật khẩu &amp; Click 'Đăng ký'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="96" y="230" as="sourcePoint" />
            <mxPoint x="354" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc01_resident_register_msg_init_2" parent="1" value="2. POST /register (username, password, phone, apartment)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="366" y="282" as="sourcePoint" />
            <mxPoint x="724" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc01_resident_register_msg_init_3" parent="1" value="3. SELECT * FROM app_users WHERE username = %s OR phone = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="334" as="sourcePoint" />
            <mxPoint x="1244" y="334" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc01_resident_register_msg_init_4" parent="1" value="4. Trả về kết quả kiểm tra trùng lặp tài khoản" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1244" y="386" as="sourcePoint" />
            <mxPoint x="736" y="386" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc01_resident_register_msg_happy_1" parent="1" value="5a. Băm mật khẩu an toàn PBKDF2/SHA-256 (generate_password_hash)" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="503" as="sourcePoint" />
            <mxPoint x="736" y="523" as="targetPoint" />
            <Array as="points">
              <mxPoint x="781" y="503" />
              <mxPoint x="781" y="523" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc01_resident_register_msg_happy_2" parent="1" value="6a. INSERT INTO app_users &amp; cu_dan (MaCuDan, HoTen, TenDangNhap, Role='Resident')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
