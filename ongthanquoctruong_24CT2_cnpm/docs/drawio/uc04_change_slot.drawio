        <mxCell id="uc04_change_slot_msg_1" parent="1" value="1. Chọn xe cần đổi &amp; Click chọn vị trí ô trống mới (VD: B1-B05)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="200" as="sourcePoint" />
            <mxPoint x="475" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_change_slot_msg_2" parent="1" value="2. POST /api/parking/change_slot (plate: '30H-999.88', new_slot: 'B1-B05')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="475" y="255" as="sourcePoint" />
            <mxPoint x="820" y="255" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_change_slot_msg_3" parent="1" value="3. Kiểm tra ô mới: SELECT TrangThai FROM bai_do WHERE MaViTri = 'B1-B05'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="310" as="sourcePoint" />
            <mxPoint x="1160" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_change_slot_msg_4" parent="1" value="4. Xác nhận ô mới còn 'Trong'" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160" y="365" as="sourcePoint" />
            <mxPoint x="820" y="365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_change_slot_msg_5" parent="1" value="5. TRANSACTION: Giải phóng ô cũ (TrangThai = 'Trong')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="420" as="sourcePoint" />
            <mxPoint x="1160" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_change_slot_msg_6" parent="1" value="6. Đặt chỗ ô mới (TrangThai = 'DaDat') &amp; Cập nhật ViTriDo trong phuong_tien" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="475" as="sourcePoint" />
            <mxPoint x="1160" y="475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_change_slot_msg_7" parent="1" value="7. Commit transaction thành công" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160" y="530" as="sourcePoint" />
            <mxPoint x="820" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_change_slot_msg_8" parent="1" value="8. Phản hồi JSON: {success: true, message: 'Đổi vị trí đỗ thành công'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
