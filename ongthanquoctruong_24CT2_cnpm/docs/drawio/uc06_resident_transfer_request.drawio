          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_else_1" parent="1" value="5b. Phản hồi HTTP 400 {success: false, message: 'Người nhận không phải cư dân tòa nhà'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
