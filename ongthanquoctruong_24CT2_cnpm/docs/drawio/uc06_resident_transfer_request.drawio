        <mxCell id="uc06_resident_transfer_request_msg_init_2" parent="1" value="2. POST /api/resident/transfer_vehicle (plate, target_phone, reason)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
