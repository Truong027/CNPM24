        <mxCell id="uc06_resident_transfer_request_msg_init_1" parent="1" value="1. Nhập SĐT người nhận, lý do chuyển nhượng &amp; Bấm 'Gửi yêu cầu'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
