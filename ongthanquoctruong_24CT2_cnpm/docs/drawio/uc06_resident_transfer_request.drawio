        <mxCell id="uc06_resident_transfer_request_msg_init_1" parent="1" value="1. Nhập SĐT người nhận, lý do chuyển nhượng &amp; Bấm 'Gửi yêu cầu'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="96" y="230" as="sourcePoint" />
            <mxPoint x="354" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_init_2" parent="1" value="2. POST /api/resident/transfer_vehicle (plate, target_phone, reason)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="366" y="282" as="sourcePoint" />
            <mxPoint x="724" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_init_3" parent="1" value="3. SELECT MaCuDan, HoTen FROM cu_dan WHERE SoDienThoai = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="334" as="sourcePoint" />
            <mxPoint x="1244" y="334" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_init_4" parent="1" value="4. Trả về thông tin cư dân nhận theo số điện thoại" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1244" y="386" as="sourcePoint" />
            <mxPoint x="736" y="386" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_happy_1" parent="1" value="5a. INSERT INTO chuyen_nhuong_xe (BienSoXe, NguoiChuyen, NguoiNhan, TrangThai='ChoDuyet')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="503" as="sourcePoint" />
            <mxPoint x="1244" y="503" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_happy_2" parent="1" value="6a. Xác nhận tạo đơn chuyển nhượng thành công (MaYeuCau = 12)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1244" y="555" as="sourcePoint" />
            <mxPoint x="736" y="555" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_else_1" parent="1" value="5b. Từ chối tạo đơn &amp; Thiết lập thông báo lỗi cư dân không hợp lệ" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
