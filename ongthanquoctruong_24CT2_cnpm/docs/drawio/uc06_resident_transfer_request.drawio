        <mxCell id="uc06_resident_transfer_request_msg_init_3" parent="1" value="3. SELECT MaCuDan, HoTen FROM cu_dan WHERE SoDienThoai = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
