        <mxCell id="uc06_resident_transfer_request_msg_else_2" parent="1" value="6b. Báo lỗi 'Không tìm thấy cư dân nhận, vui lòng kiểm tra lại SĐT'" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
