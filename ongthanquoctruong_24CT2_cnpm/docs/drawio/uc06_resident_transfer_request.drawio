        <mxCell id="uc06_resident_transfer_request_msg_init_1" parent="1" value="1. Nhập SĐT người nhận, lý do chuyển nhượng &amp; Bấm 'Gửi yêu cầu'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="200" as="sourcePoint" />
            <mxPoint x="500" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_init_2" parent="1" value="2. POST /api/resident/transfer_vehicle (plate, target_phone, reason)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="250" as="sourcePoint" />
            <mxPoint x="840" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_init_3" parent="1" value="3. SELECT MaCuDan, HoTen FROM cu_dan WHERE SoDienThoai = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="300" as="sourcePoint" />
            <mxPoint x="1170" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_init_4" parent="1" value="4. Trả về thông tin cư dân nhận theo số điện thoại" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="350" as="sourcePoint" />
            <mxPoint x="840" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Tìm thấy cư dân nhận hợp lệ &amp; Khác chủ xe hiện tại]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=340;height=26;dashed=1;dashPattern=8 4;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#0F172A;" vertex="1">
          <mxGeometry x="90" y="410" width="1200" height="400" as="geometry" />
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_happy_1" parent="1" value="5a. INSERT INTO chuyen_nhuong_xe (BienSoXe, NguoiChuyen, NguoiNhan, TrangThai='ChoDuyet')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="445" as="sourcePoint" />
            <mxPoint x="1170" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_happy_2" parent="1" value="6a. Xác nhận tạo đơn chuyển nhượng thành công (MaYeuCau = 12)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="495" as="sourcePoint" />
            <mxPoint x="840" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_happy_3" parent="1" value="7a. Phản hồi HTTP 200 {success: true, request_id: 12, status: 'ChoDuyet'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="545" as="sourcePoint" />
            <mxPoint x="500" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_msg_happy_4" parent="1" value="8a. Hiển thị thông báo 'Đã gửi đơn chuyển nhượng, vui lòng chờ Admin phê duyệt'" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="595" as="sourcePoint" />
            <mxPoint x="170" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc06_resident_transfer_request_alt_divider" parent="1" value="&lt;b&gt;[else: SĐT không tồn tại hoặc Cố tình chuyển nhượng cho chính mình]&lt;/b&gt;" style="html=1;strokeWidth=1.5;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=15;fontColor=#B91C1C;fontSize=11;fontStyle=0;" edge="1">
