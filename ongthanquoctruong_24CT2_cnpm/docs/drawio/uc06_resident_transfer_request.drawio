        <mxCell id="uc06_resident_transfer_request_msg_init_4" parent="1" value="4. Trả về thông tin cư dân nhận theo số điện thoại" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
