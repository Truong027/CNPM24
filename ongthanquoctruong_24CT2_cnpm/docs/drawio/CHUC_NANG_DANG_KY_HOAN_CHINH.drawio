<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-10-16T00:00:00.000Z" agent="GitHub-Copilot" version="24.7.17" type="device">
  <diagram id="complete-register-flow" name="Chức năng đăng ký hoàn chỉnh">
    <mxGraphModel dx="1500" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;SƠ ĐỒ LUỒNG XỬ LÝ CHỨC NĂNG ĐĂNG KÝ TÀI KHOẢN&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;fe/templates/register.html → be/app.py → database.py → tài khoản cư dân&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="840" height="55" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;START&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=15;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="640" y="105" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="open" value="&lt;b&gt;Mở trang đăng nhập trước&lt;/b&gt;&lt;br/&gt;GET `/login`&lt;br/&gt;Người dùng bấm liên kết Đăng ký để mở form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="535" y="215" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;b&gt;Mở trang đăng ký và nhập thông tin&lt;/b&gt;&lt;br/&gt;GET `/register`&lt;br/&gt;Họ tên, username, email, số điện thoại&lt;br/&gt;Mật khẩu, xác nhận mật khẩu, thông tin xe (tùy chọn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=12;fontColor=#0C4A6E;" vertex="1" parent="1"><mxGeometry x="490" y="350" width="520" height="95" as="geometry"/></mxCell>
        <mxCell id="validate" value="&lt;b&gt;Kiểm tra dữ liệu đầu vào&lt;/b&gt;&lt;br/&gt;Bắt buộc, định dạng phone, độ dài username/password, xác nhận mật khẩu" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=12;fontColor=#581C87;" vertex="1" parent="1"><mxGeometry x="545" y="495" width="410" height="115" as="geometry"/></mxCell>
        <mxCell id="input-error" value="&lt;b&gt;Báo lỗi form&lt;/b&gt;&lt;br/&gt;HTTP 400, hiển thị lỗi cụ thể&lt;br/&gt;Giữ nguyên dữ liệu để người dùng sửa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="65" y="510" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;Gửi yêu cầu đăng ký&lt;/b&gt;&lt;br/&gt;POST `/api/register`&lt;br/&gt;`be/app.py: api_register()`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="535" y="665" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="duplicate" value="&lt;b&gt;Kiểm tra trùng tài khoản&lt;/b&gt;&lt;br/&gt;Username, email, số điện thoại đã tồn tại?&lt;br/&gt;Kiểm tra qua `database.register_user()`" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;fontSize=12;fontColor=#581C87;" vertex="1" parent="1"><mxGeometry x="520" y="810" width="460" height="115" as="geometry"/></mxCell>
        <mxCell id="duplicate-result" value="&lt;b&gt;Thông tin hợp lệ và chưa tồn tại?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=12;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="555" y="975" width="390" height="95" as="geometry"/></mxCell>
        <mxCell id="fail" value="&lt;b&gt;Đăng ký thất bại&lt;/b&gt;&lt;br/&gt;HTTP 400: tài khoản trùng hoặc dữ liệu không hợp lệ&lt;br/&gt;Quay lại form đăng ký" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="55" y="975" width="390" height="95" as="geometry"/></mxCell>
        <mxCell id="create" value="&lt;b&gt;Tạo tài khoản cư dân&lt;/b&gt;&lt;br/&gt;Hash mật khẩu và INSERT `app_users` + `cu_dan`&lt;br/&gt;Nếu có biển số: lưu phương tiện, vé và vị trí đỗ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1060" y="975" width="405" height="105" as="geometry"/></mxCell>
        <mxCell id="success" value="&lt;b&gt;Đăng ký thành công&lt;/b&gt;&lt;br/&gt;HTTP 200, thông báo yêu cầu đăng nhập&lt;br/&gt;Chuyển sang `/login`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;fontSize=12;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="1060" y="1120" width="405" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="start" target="open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="open" target="input"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="input" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Không" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#DC2626;fontColor=#991B1B;" edge="1" parent="1" source="validate" target="input-error"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Có" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#16A34A;fontColor=#166534;" edge="1" parent="1" source="validate" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="api" target="duplicate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;" edge="1" parent="1" source="duplicate" target="duplicate-result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Không" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#DC2626;fontColor=#991B1B;" edge="1" parent="1" source="duplicate-result" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Có" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#16A34A;fontColor=#166534;" edge="1" parent="1" source="duplicate-result" target="create"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Commit thành công" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#16A34A;fontColor=#166534;" edge="1" parent="1" source="create" target="success"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
