        <mxCell id="uc03_resident_register_vehicle_msg_init_1" parent="1" value="1. Nhập biển số, hiệu xe &amp; Click chọn vị trí ô đỗ Cinema (VD: B1-A01)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
