        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_init_1" parent="1" value="1. Xe tiến vào làn cổng, Camera gửi luồng video frames tới màn hình bàn trực" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="230" as="sourcePoint" />
            <mxPoint x="460" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_init_2" parent="1" value="2. Stream khung hình video trực tiếp tới backend AI xử lý" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="282" as="sourcePoint" />
            <mxPoint x="920" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_init_3" parent="1" value="3. YOLOv8 cắt vùng biển số -&gt; CRNN nhận dạng ký tự (VD: '51G-123.45')" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="334" as="sourcePoint" />
            <mxPoint x="920" y="354" as="targetPoint" />
            <Array as="points">
              <mxPoint x="965" y="334" />
              <mxPoint x="965" y="354" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_init_4" parent="1" value="4. Tra cứu phiên đỗ: SELECT id FROM parking_sessions WHERE plate_text = %s AND status = 'Parked'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="386" as="sourcePoint" />
            <mxPoint x="1320" y="386" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_init_5" parent="1" value="5. Trả về kết quả kiểm tra phiên đỗ hiện tại của xe" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1320" y="438" as="sourcePoint" />
            <mxPoint x="920" y="438" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Không có phiên trùng lặp &amp; Biển số nhận diện rõ ràng (Xe vào hợp lệ)]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=340;height=26;dashed=1;dashPattern=8 4;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#0F172A;" vertex="1">
          <mxGeometry x="50" y="500" width="1430" height="516" as="geometry" />
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_1" parent="1" value="6a. INSERT INTO parking_sessions (plate_text, check_in_time=NOW(), status='Parked', gate_in='Cổng Vào')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="535" as="sourcePoint" />
            <mxPoint x="1320" y="535" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_2" parent="1" value="7a. Lưu bản ghi ảnh chụp vào detections &amp; lich_su_ra_vao" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="587" as="sourcePoint" />
            <mxPoint x="1320" y="587" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_3" parent="1" value="8a. Xác nhận tạo phiên gửi xe mới thành công" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1320" y="639" as="sourcePoint" />
            <mxPoint x="920" y="639" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_4" parent="1" value="9a. Gửi tín hiệu điều khiển mở Barrier cổng vào (barrier_state = 'OPEN')" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="691" as="sourcePoint" />
            <mxPoint x="920" y="711" as="targetPoint" />
            <Array as="points">
              <mxPoint x="965" y="691" />
              <mxPoint x="965" y="711" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_5" parent="1" value="10a. Đẩy sự kiện Live Event WebSocket: 'Xe vào thành công' kèm ảnh chụp biển số" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="743" as="sourcePoint" />
            <mxPoint x="460" y="743" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_6" parent="1" value="11a. Cần Barrier nâng lên, màn hình LED hiển thị: 'Kính chào quý khách: 51G-123.45'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="795" as="sourcePoint" />
            <mxPoint x="115" y="795" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_alt_divider" parent="1" value="&lt;b&gt;[else: Xe đang có phiên mở chưa checkout hoặc Biển số mờ không nhận diện được]&lt;/b&gt;" style="html=1;strokeWidth=1.5;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=15;fontColor=#B91C1C;fontSize=11;fontStyle=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="50" y="862" as="sourcePoint" />
            <mxPoint x="1480" y="862" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_else_1" parent="1" value="6b. Đẩy cảnh báo an ninh về Bàn trực bảo vệ: 'Biển số trùng lặp / Nhận diện mờ'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#B91C1C;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="892" as="sourcePoint" />
            <mxPoint x="460" y="892" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_else_2" parent="1" value="7b. Giữ nguyên Barrier đóng &amp; Bật cửa sổ yêu cầu Bảo vệ kiểm tra, nhập biển số thủ công" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#B91C1C;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="944" as="sourcePoint" />
