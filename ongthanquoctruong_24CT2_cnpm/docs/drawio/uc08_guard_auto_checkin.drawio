        <mxCell id="uc08_guard_auto_checkin_ll_ui" parent="1" value="&lt;b&gt;GIAO DIỆN&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 10px; font-family: Consolas, monospace;'&gt;&lt;i&gt;D:\CNPM24CT2_OngThanQuocTruong\ongthanquoctruong_24CT2_cnpm\&lt;br/&gt;fe\templates\index.html&lt;br/&gt;(Tab #recognition-page, Live Stream)&lt;/i&gt;&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=125;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
