          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_happy_3" parent="1" value="7a. Xác nhận cập nhật thông tin thành công (Affected rows = 1)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
