        <mxCell id="uc11_admin_user_mgmt_msg_post_1" parent="1" value="8. Phản hồi kết quả cập nhật (HTTP 200 Thành công hoặc HTTP 403 Từ chối)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
