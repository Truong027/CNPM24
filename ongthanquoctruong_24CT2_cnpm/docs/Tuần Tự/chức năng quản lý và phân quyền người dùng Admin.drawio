        <mxCell id="uc11_admin_user_mgmt_msg_init_1" parent="1" value="1. Chọn tài khoản cần chỉnh sửa, cập nhật quyền hạn/trạng thái &amp; Bấm 'Lưu thay đổi'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="96" y="230" as="sourcePoint" />
            <mxPoint x="354" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_init_2" parent="1" value="2. POST /api/admin/users/update (user_id: 5, role: 'Operator', status: 'active')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="366" y="282" as="sourcePoint" />
            <mxPoint x="724" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_init_3" parent="1" value="3. Tra cứu quyền hạn tài khoản mục tiêu: SELECT role FROM app_users WHERE id = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="334" as="sourcePoint" />
            <mxPoint x="1244" y="334" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_init_4" parent="1" value="4. Trả về thông tin vai trò hiện tại của tài khoản" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1244" y="386" as="sourcePoint" />
            <mxPoint x="736" y="386" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_happy_1" parent="1" value="5a. UPDATE app_users SET role = %s, status = %s WHERE id = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="503" as="sourcePoint" />
            <mxPoint x="1244" y="503" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc11_admin_user_mgmt_msg_happy_2" parent="1" value="6a. Đồng bộ cập nhật bảng cu_dan / nhan_vien tương ứng" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="555" as="sourcePoint" />
