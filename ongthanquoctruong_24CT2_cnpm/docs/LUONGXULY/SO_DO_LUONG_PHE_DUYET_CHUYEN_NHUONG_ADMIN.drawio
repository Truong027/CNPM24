        <mxCell id="success-approve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontColor=#14532D;arcSize=10;" value="&lt;b&gt;Phê duyệt thành công&lt;/b&gt;&lt;br/&gt;UPDATE phuong_tien &amp; vehicles&lt;br/&gt;UPDATE chuyen_nhuong_xe &#39;Approved&#39;&lt;br/&gt;&lt;font color=&#39;#166534&#39; style=&#39;font-size: 10px&#39;&gt;HTTP 200, Đổi huy hiệu xanh lá &#39;Approved&#39;&lt;br/&gt;loadTransferRequests()&lt;/font&gt;" vertex="1">
