        <mxCell id="transfers-page" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=13;fontColor=#FFFFFF;arcSize=10;" value="&lt;b&gt;Mở trang Chuyển nhượng&lt;/b&gt;&lt;br/&gt;Tab #transfers-page&lt;br/&gt;&lt;font color=&#39;#CBD5E1&#39; style=&#39;font-size: 11px&#39;&gt;GET `/api/admin/transfer_requests`&lt;br/&gt;Tải danh sách đơn chuyển nhượng&lt;/font&gt;" vertex="1">
