          <mxGeometry height="70" width="145" x="40" y="310" as="geometry" />
        </mxCell>
        <mxCell id="web" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=13;fontColor=#FFFFFF;arcSize=10;" value="&lt;b&gt;Mở web &amp; Đăng nhập&lt;/b&gt;&lt;br/&gt;Đăng nhập Quản trị viên&lt;br/&gt;&lt;font color=&#39;#CBD5E1&#39; style=&#39;font-size: 11px&#39;&gt;http://127.0.0.1:5000&lt;br/&gt;Tài khoản role=&#39;Admin&#39;&lt;/font&gt;" vertex="1">
