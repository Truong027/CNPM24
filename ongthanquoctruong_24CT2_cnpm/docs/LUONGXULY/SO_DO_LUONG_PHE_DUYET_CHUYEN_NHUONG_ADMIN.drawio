        </mxCell>
        <mxCell id="select-request" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;arcSize=10;" value="&lt;b&gt;Xem chi tiết &amp; Chọn đơn&lt;/b&gt;&lt;br/&gt;Biển số xe, Cư dân chuyển,&lt;br/&gt;Cư dân nhận, Thời gian tạo&lt;br/&gt;&lt;font color=&#39;#CBD5E1&#39; style=&#39;font-size: 11px&#39;&gt;Trạng thái &#39;Pending&#39;&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="220" x="735" y="295" as="geometry" />
        </mxCell>
        <mxCell id="choose-action" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;arcSize=10;" value="&lt;b&gt;Chọn hành động xử lý&lt;/b&gt;&lt;br/&gt;Bấm nút [Phê duyệt] hoặc&lt;br/&gt;Bấm nút [Từ chối]&lt;br/&gt;&lt;font color=&#39;#CBD5E1&#39; style=&#39;font-size: 11px&#39;&gt;processTransferAction(id, action)&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="210" x="1000" y="295" as="geometry" />
