        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;arcSize=10;" value="&lt;b&gt;Gửi yêu cầu cập nhật&lt;/b&gt;&lt;br/&gt;POST `/api/admin/users/update`&lt;br/&gt;&lt;font color=&#39;#64748B&#39; style=&#39;font-size: 10px&#39;&gt;api_admin_update_user()&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="220" x="1265" y="495" as="geometry" />
        </mxCell>
        <mxCell id="role-check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;" value="&lt;b&gt;Thẩm quyền Admin hợp lệ?&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#CBD5E1&#39; style=&#39;font-size: 10px&#39;&gt;session[&#39;user&#39;][&#39;role&#39;] == &#39;Admin&#39;&lt;/font&gt;" vertex="1">
