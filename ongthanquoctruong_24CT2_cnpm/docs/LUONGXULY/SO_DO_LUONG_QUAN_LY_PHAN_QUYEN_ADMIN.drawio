        <mxCell id="fail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontColor=#7F1D1D;arcSize=10;" value="&lt;b&gt;Cập nhật thất bại&lt;/b&gt;&lt;br/&gt;Không có quyền hoặc không tìm thấy SĐT&lt;br/&gt;&lt;font color=&#39;#7F1D1D&#39; style=&#39;font-size: 10px&#39;&gt;HTTP 400/403, Alert báo lỗi&lt;/font&gt;" vertex="1">
