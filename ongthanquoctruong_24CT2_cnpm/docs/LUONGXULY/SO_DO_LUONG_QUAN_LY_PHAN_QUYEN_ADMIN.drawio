        </mxCell>
        <mxCell id="user-exist-check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#1E293B;" value="&lt;b&gt;Tài khoản tồn tại trong DB?&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#64748B&#39; style=&#39;font-size: 10px&#39;&gt;SELECT id FROM app_users&lt;br/&gt;WHERE phone = %s (original_phone)&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="220" x="1785" y="475" as="geometry" />
        </mxCell>
