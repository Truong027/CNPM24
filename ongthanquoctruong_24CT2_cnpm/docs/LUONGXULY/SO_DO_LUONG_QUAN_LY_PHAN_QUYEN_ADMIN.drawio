        <mxCell id="success" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontColor=#14532D;arcSize=10;" value="&lt;b&gt;Cập nhật thành công&lt;/b&gt;&lt;br/&gt;Commit Transaction CSDL&lt;br/&gt;HTTP 200, Alert thông báo thành công&lt;br/&gt;Đóng modal &amp; Tải lại danh sách&lt;br/&gt;&lt;font color=&#39;#166534&#39; style=&#39;font-size: 10px&#39;&gt;loadUsersList()&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="230" x="2320" y="485" as="geometry" />
