<mxfile host="app.diagrams.net" agent="Antigravity-CNPM24">
  <diagram id="user-mgmt-flow" name="Luồng xử lý quản lý và phân quyền người dùng Admin">
    <mxGraphModel dx="1776" dy="909" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontColor=#1E293B;fontStyle=1;" value="&lt;b&gt;4.3 THIẾT KẾ PHẦN MỀM - CHỨC NĂNG QUẢN LÝ VÀ PHÂN QUYỀN NGƯỜI DÙNG ADMIN&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="1050" x="350" y="25" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0EA5A8;strokeColor=#0F766E;strokeWidth=2;fontSize=16;fontColor=#FFFFFF;arcSize=12;" value="&lt;b&gt;START&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="145" x="40" y="310" as="geometry" />
        </mxCell>
        <mxCell id="web" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=13;fontColor=#FFFFFF;arcSize=10;" value="&lt;b&gt;Mở web &amp; Đăng nhập&lt;/b&gt;&lt;br/&gt;Đăng nhập Quản trị viên&lt;br/&gt;&lt;font color=&#39;#CBD5E1&#39; style=&#39;font-size: 11px&#39;&gt;http://127.0.0.1:5000&lt;br/&gt;Tài khoản role=&#39;Admin&#39;&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="210" x="225" y="295" as="geometry" />
        </mxCell>
        <mxCell id="users-page" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=13;fontColor=#FFFFFF;arcSize=10;" value="&lt;b&gt;Mở trang Quản lý User&lt;/b&gt;&lt;br/&gt;Tab #users-page&lt;br/&gt;&lt;font color=&#39;#CBD5E1&#39; style=&#39;font-size: 11px&#39;&gt;GET `/api/admin/users`&lt;br/&gt;Tải danh sách tài khoản hệ thống&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="220" x="475" y="295" as="geometry" />
        </mxCell>
        <mxCell id="select-user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;arcSize=10;" value="&lt;b&gt;Chọn tài khoản cần sửa&lt;/b&gt;&lt;br/&gt;Bấm nút &#39;Sửa&#39; trên bảng&lt;br/&gt;&lt;font color=&#39;#CBD5E1&#39; style=&#39;font-size: 11px&#39;&gt;Mở Modal #editUserModal&lt;br/&gt;Đổ dữ liệu tài khoản lên form&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="220" x="735" y="295" as="geometry" />
        </mxCell>
        <mxCell id="edit-form" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;arcSize=10;" value="&lt;b&gt;Chỉnh sửa thông tin &amp; quyền&lt;/b&gt;&lt;br/&gt;Họ tên, SĐT, Email, Mật khẩu&lt;br/&gt;Vai trò: Admin / Operator / Resident&lt;br/&gt;Trạng thái: Hoạt động / Tạm khóa&lt;br/&gt;Căn hộ / Ca trực" vertex="1">
          <mxGeometry height="110" width="220" x="735" y="490" as="geometry" />
        </mxCell>
        <mxCell id="input-check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#18181B;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;" value="&lt;b&gt;Dữ liệu nhập hợp lệ?&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#CBD5E1&#39; style=&#39;font-size: 10px&#39;&gt;Có username &amp; họ tên&lt;br/&gt;Mật khẩu mới ≥ 6 ký tự (nếu có)&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="220" x="1000" y="475" as="geometry" />
        </mxCell>
        <mxCell id="form-error" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontColor=#7F1D1D;arcSize=10;" value="&lt;b&gt;Dữ liệu không hợp lệ&lt;/b&gt;&lt;br/&gt;Hiển thị Alert cảnh báo lỗi&lt;br/&gt;Giữ nguyên modal để nhập lại" vertex="1">
