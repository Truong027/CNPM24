        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_msg_else_1" parent="1" value="3b. Phản hồi HTTP 400 {success: false, message: 'Giao dịch chưa hoàn tất'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
