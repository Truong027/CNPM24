            <mxPoint x="1170" y="345" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_msg_happy_2" parent="1" value="4a. INSERT INTO hoa_don (MaPhien, SoTien, HinhThucThanhToan, NgayLap)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="395" as="sourcePoint" />
