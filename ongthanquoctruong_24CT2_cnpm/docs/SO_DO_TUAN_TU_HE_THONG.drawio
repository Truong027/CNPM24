        <mxCell id="uc05_resident_renew_pass_msg_init_4" parent="1" value="4. Trả về ngày hết hạn hiện tại của phương tiện" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
