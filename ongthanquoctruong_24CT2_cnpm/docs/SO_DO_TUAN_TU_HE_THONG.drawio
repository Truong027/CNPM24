        <mxCell id="uc11_admin_user_mgmt_msg_1" parent="1" value="1. Chọn tài khoản cần chỉnh sửa, cập nhật quyền hạn/trạng thái khóa &amp; Bấm 'Lưu'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
