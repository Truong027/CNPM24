        <mxCell id="uc13_admin_analytics_msg_1" parent="1" value="1. Chọn xem báo cáo doanh thu theo tháng và biểu đồ mật độ 24 giờ" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
