          <mxGeometry x="1040" y="60" width="240" height="750" as="geometry" />
        </mxCell>
        <mxCell id="uc05_renew_pass_msg_1" parent="1" value="1. Chọn gói gia hạn (1, 3 hoặc 6 tháng) &amp; Bấm 'Xác nhận gia hạn'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
