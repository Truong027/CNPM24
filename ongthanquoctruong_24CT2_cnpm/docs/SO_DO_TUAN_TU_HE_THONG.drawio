          </mxGeometry>
        </mxCell>
        <mxCell id="uc03_resident_register_vehicle_msg_happy_2" parent="1" value="6a. INSERT INTO vehicles &amp; phuong_tien (BienSoXe, MaCuDan, ViTriDo, NgayHetHan)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
