        <mxCell id="uc08_guard_auto_checkin_actor_icon" parent="1" value="&lt;b&gt;TÁC NHÂN&lt;/b&gt;&lt;br/&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;Nhân Viên Bảo Vệ&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;(Security Guard)&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=center;" vertex="1">
          <mxGeometry x="140" y="60" width="60" height="65" as="geometry" />
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_ll_actor" parent="1" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#1D4ED8;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="165" as="sourcePoint" />
            <mxPoint x="170" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_ll_ui" parent="1" value="&lt;b&gt;GIAO DIỆN&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;fe/templates/index.html&lt;br/&gt;(Tab #recognition-page, Live Stream)&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="380" y="60" width="240" height="940" as="geometry" />
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_ll_sys" parent="1" value="&lt;b&gt;HỆ THỐNG&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code / Hàm]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;be/app.py: gen_frames() &amp; detect_plates_from_frame()&lt;br/&gt;be/database.py: process_parking_transaction()&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="710" y="60" width="260" height="940" as="geometry" />
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_ll_db" parent="1" value="&lt;b&gt;CƠ SỞ DỮ LIỆU&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[db / Bảng]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;HTTT_QuanLyBaiXe_AI /&lt;br/&gt;parking_sessions, lich_su_ra_vao, detections&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="1050" y="60" width="240" height="940" as="geometry" />
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_init_1" parent="1" value="1. Xe tiến vào làn cổng, Camera gửi luồng video frames tới màn hình bàn trực" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="200" as="sourcePoint" />
            <mxPoint x="500" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_init_2" parent="1" value="2. Stream khung hình video trực tiếp tới backend AI xử lý" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="250" as="sourcePoint" />
            <mxPoint x="840" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_init_3" parent="1" value="3. YOLOv8 cắt vùng biển số -&gt; CRNN nhận dạng ký tự (VD: '51G-123.45')" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="300" as="sourcePoint" />
            <mxPoint x="840" y="320" as="targetPoint" />
            <Array as="points">
              <mxPoint x="885" y="300" />
              <mxPoint x="885" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_init_4" parent="1" value="4. Tra cứu phiên đỗ: SELECT id FROM parking_sessions WHERE plate_text = %s AND status = 'Parked'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="350" as="sourcePoint" />
            <mxPoint x="1170" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_init_5" parent="1" value="5. Trả về kết quả kiểm tra phiên đỗ hiện tại của xe" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="400" as="sourcePoint" />
            <mxPoint x="840" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Không có phiên trùng lặp &amp; Biển số nhận diện rõ ràng (Xe vào hợp lệ)]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=340;height=26;dashed=1;dashPattern=8 4;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#0F172A;" vertex="1">
          <mxGeometry x="90" y="460" width="1200" height="500" as="geometry" />
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_1" parent="1" value="6a. INSERT INTO parking_sessions (plate_text, check_in_time=NOW(), status='Parked', gate_in='Cổng Vào')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="495" as="sourcePoint" />
            <mxPoint x="1170" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_2" parent="1" value="7a. Lưu bản ghi ảnh chụp vào detections &amp; lich_su_ra_vao" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="545" as="sourcePoint" />
            <mxPoint x="1170" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_3" parent="1" value="8a. Xác nhận tạo phiên gửi xe mới thành công" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="595" as="sourcePoint" />
            <mxPoint x="840" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_4" parent="1" value="9a. Gửi tín hiệu điều khiển mở Barrier cổng vào (barrier_state = 'OPEN')" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="645" as="sourcePoint" />
            <mxPoint x="840" y="665" as="targetPoint" />
            <Array as="points">
              <mxPoint x="885" y="645" />
              <mxPoint x="885" y="665" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_5" parent="1" value="10a. Đẩy sự kiện Live Event WebSocket: 'Xe vào thành công' kèm ảnh chụp biển số" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="695" as="sourcePoint" />
            <mxPoint x="500" y="695" as="targetPoint" />
          </mxGeometry>
        </mxCell>
