        <mxCell id="uc07_resident_history_msg_init_2" parent="1" value="2. GET /api/resident/history?plate=30H-999.88" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
