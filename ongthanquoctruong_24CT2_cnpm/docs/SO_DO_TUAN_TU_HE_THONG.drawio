            <mxPoint x="920" y="386" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc03_resident_register_vehicle_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Ô đỗ còn TRỐNG (TrangThai == 'Trong')]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=310;height=26;dashed=1;dashPattern=8 4;strokeColor=#4338CA;fillColor=#EEF2FF;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#1E1B4B;" vertex="1">
          <mxGeometry x="680" y="448" width="810" height="308" as="geometry" />
        </mxCell>
        <mxCell id="uc03_resident_register_vehicle_msg_happy_1" parent="1" value="5a. UPDATE bai_do SET TrangThai = 'DaDat', BienSoXe = %s WHERE MaViTri = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
