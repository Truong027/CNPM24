  <diagram id="uc11_admin_user_mgmt" name="[Admin] UC11 - Quản lý tài khoản người dùng &amp; Phân quyền">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="980" math="0" shadow="0">
