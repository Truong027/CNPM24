        <mxCell id="uc11_admin_user_mgmt_msg_happy_2" parent="1" value="6a. Đồng bộ cập nhật bảng cu_dan / nhan_vien tương ứng" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
