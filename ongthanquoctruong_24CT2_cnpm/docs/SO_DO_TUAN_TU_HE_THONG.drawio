        <mxCell id="uc07_resident_history_msg_init_4" parent="1" value="4. Trả về danh sách các phiên gửi xe tương ứng" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
