        <mxCell id="uc05_resident_renew_pass_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Tìm thấy phương tiện hợp lệ &amp; Gói gia hạn đúng quy định]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=310;height=26;dashed=1;dashPattern=8 4;strokeColor=#4338CA;fillColor=#EEF2FF;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#1E1B4B;" vertex="1">
          <mxGeometry x="680" y="448" width="810" height="360" as="geometry" />
        </mxCell>
        <mxCell id="uc05_resident_renew_pass_msg_happy_1" parent="1" value="5a. Tính thời hạn mới: new_expiry = max(current_expiry, today) + 3 months" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
