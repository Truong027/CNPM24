        <mxCell id="uc10_guard_collect_fee_barrier_msg_happy_4" parent="1" value="6a. Gửi lệnh điều khiển phần cứng mở cần Barrier cổng ra (Barrier_Out = 'OPEN')" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="495" as="sourcePoint" />
            <mxPoint x="840" y="515" as="targetPoint" />
            <Array as="points">
              <mxPoint x="885" y="495" />
              <mxPoint x="885" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_msg_happy_5" parent="1" value="7a. Phản hồi HTTP 200 {success: true, invoice_code: 'HD-20261002-01', barrier: 'OPEN'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="545" as="sourcePoint" />
            <mxPoint x="500" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_msg_happy_6" parent="1" value="8a. In hóa đơn/phiếu xuất bãi, nâng cần Barrier cho xe ra &amp; Cập nhật số chỗ trống" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="595" as="sourcePoint" />
            <mxPoint x="170" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_alt_divider" parent="1" value="&lt;b&gt;[else: Chưa nhận được thanh toán hoặc Có tranh chấp cước phí]&lt;/b&gt;" style="html=1;strokeWidth=1.5;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=15;fontColor=#B91C1C;fontSize=11;fontStyle=0;" edge="1">
