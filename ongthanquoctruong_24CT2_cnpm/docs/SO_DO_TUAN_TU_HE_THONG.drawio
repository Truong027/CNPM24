        <mxCell id="uc03_resident_register_vehicle_msg_init_4" parent="1" value="4. Trả về trạng thái hiện tại của ô đỗ" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
