  <diagram id="uc08_guard_auto_checkin" name="[Bảo Vệ] UC08 - Nhận diện AI &amp; Tự động Check-in xe vào">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1080" math="0" shadow="0">
