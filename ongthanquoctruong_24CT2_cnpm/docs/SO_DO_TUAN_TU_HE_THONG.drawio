        <mxCell id="uc03_resident_register_vehicle_msg_happy_5" parent="1" value="9a. Đổi màu ô ghế Cinema sang Cyan (Xe của bạn) &amp; Cập nhật thẻ xe 3D" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
