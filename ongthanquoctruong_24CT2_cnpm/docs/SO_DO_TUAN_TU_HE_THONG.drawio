        <mxCell id="uc04_resident_change_slot_msg_else_2" parent="1" value="6b. Phản hồi HTTP 400 {success: false, message: 'Vị trí mới không khả dụng'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="840" as="sourcePoint" />
            <mxPoint x="500" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc04_resident_change_slot_msg_else_3" parent="1" value="7b. Báo lỗi 'Không thể đổi sang vị trí này', giữ nguyên vị trí cũ" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="890" as="sourcePoint" />
            <mxPoint x="170" y="890" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uc05_resident_renew_pass" name="[Cư Dân] UC05 - Gia hạn vé tháng cư dân">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1030" math="0" shadow="0">
