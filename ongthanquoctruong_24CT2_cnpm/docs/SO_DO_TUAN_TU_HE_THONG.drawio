        <mxCell id="uc03_resident_register_vehicle_ll_db" parent="1" value="&lt;b&gt;CƠ SỞ DỮ LIỆU&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[db / Bảng]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 10.5px;'&gt;&lt;i&gt;HTTT_QuanLyBaiXe_AI /&lt;br/&gt;bai_do, vehicles, phuong_tien&lt;/i&gt;&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=125;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="1190" y="60" width="280" height="875" as="geometry" />
        </mxCell>
        <mxCell id="uc03_resident_register_vehicle_msg_init_1" parent="1" value="1. Nhập biển số, hiệu xe &amp; Click chọn vị trí ô đỗ Cinema (VD: B1-A01)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
