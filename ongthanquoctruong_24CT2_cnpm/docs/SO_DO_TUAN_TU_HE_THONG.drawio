        <mxCell id="uc11_admin_user_mgmt_msg_init_1" parent="1" value="1. Chọn tài khoản cần chỉnh sửa, cập nhật quyền hạn/trạng thái &amp; Bấm 'Lưu thay đổi'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
