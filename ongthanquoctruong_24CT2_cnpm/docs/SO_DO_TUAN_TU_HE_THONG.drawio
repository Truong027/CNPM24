            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc05_resident_renew_pass_msg_happy_2" parent="1" value="6a. UPDATE phuong_tien &amp; vehicles SET NgayHetHan = %s WHERE BienSoXe = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
