        <mxCell id="uc05_resident_renew_pass_msg_happy_4" parent="1" value="8a. Xác nhận cập nhật CSDL thành công" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10.5;" edge="1">
