        <mxCell id="uc08_guard_auto_checkin_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Không có phiên trùng lặp &amp; Biển số nhận diện rõ ràng (Xe vào hợp lệ)]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=310;height=26;dashed=1;dashPattern=8 4;strokeColor=#4338CA;fillColor=#EEF2FF;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#1E1B4B;" vertex="1">
          <mxGeometry x="680" y="500" width="810" height="360" as="geometry" />
        </mxCell>
        <mxCell id="uc08_guard_auto_checkin_msg_happy_1" parent="1" value="6a. INSERT INTO parking_sessions (plate_text, check_in_time=NOW(), status='Parked', gate_in='Cổng Vào')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
