          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="165" as="sourcePoint" />
            <mxPoint x="170" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_ll_ui" parent="1" value="&lt;b&gt;GIAO DIỆN&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;fe/templates/login.html&lt;br/&gt;(Form #loginForm)&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="380" y="60" width="240" height="740" as="geometry" />
        </mxCell>
        <mxCell id="uc02_resident_login_ll_sys" parent="1" value="&lt;b&gt;HỆ THỐNG&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[File code / Hàm]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;be/app.py: login()&lt;br/&gt;be/database.py: check_user_credentials()&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="710" y="60" width="260" height="740" as="geometry" />
        </mxCell>
        <mxCell id="uc02_resident_login_ll_db" parent="1" value="&lt;b&gt;CƠ SỞ DỮ LIỆU&lt;/b&gt;&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;[db / Bảng]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;HTTT_QuanLyBaiXe_AI /&lt;br/&gt;app_users, cu_dan&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=100;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;fontColor=#0F172A;rounded=1;shadow=0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="1050" y="60" width="240" height="740" as="geometry" />
        </mxCell>
        <mxCell id="uc02_resident_login_msg_init_1" parent="1" value="1. Nhập tên đăng nhập, mật khẩu &amp; Bấm 'Đăng nhập'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="200" as="sourcePoint" />
            <mxPoint x="500" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_msg_init_2" parent="1" value="2. POST /login (username, password)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="250" as="sourcePoint" />
            <mxPoint x="840" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_msg_init_3" parent="1" value="3. SELECT id, username, password_hash, role, status FROM app_users WHERE username = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="300" as="sourcePoint" />
            <mxPoint x="1170" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_msg_init_4" parent="1" value="4. Trả về thông tin người dùng và mã băm password_hash" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="350" as="sourcePoint" />
            <mxPoint x="840" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Mật khẩu chính xác &amp; status == 'active' &amp; role == 'Resident']" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=340;height=26;dashed=1;dashPattern=8 4;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#0F172A;" vertex="1">
          <mxGeometry x="90" y="410" width="1200" height="350" as="geometry" />
        </mxCell>
        <mxCell id="uc02_resident_login_msg_happy_1" parent="1" value="5a. Khởi tạo session['user'] = {id, role: 'Resident', username}" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="445" as="sourcePoint" />
            <mxPoint x="840" y="465" as="targetPoint" />
            <Array as="points">
              <mxPoint x="885" y="445" />
              <mxPoint x="885" y="465" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_msg_happy_2" parent="1" value="6a. Phản hồi HTTP 200 {success: true, role: 'Resident', redirect: '/resident-dashboard'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="495" as="sourcePoint" />
            <mxPoint x="500" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_msg_happy_3" parent="1" value="7a. Điều hướng vào Cổng thông tin Cư dân (Resident Dashboard)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="545" as="sourcePoint" />
            <mxPoint x="170" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_alt_divider" parent="1" value="&lt;b&gt;[else: Sai mật khẩu hoặc Tài khoản bị vô hiệu hóa (status != 'active')]&lt;/b&gt;" style="html=1;strokeWidth=1.5;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=15;fontColor=#B91C1C;fontSize=11;fontStyle=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="610" as="sourcePoint" />
            <mxPoint x="1290" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_msg_else_1" parent="1" value="5b. Phản hồi HTTP 401 {success: false, message: 'Sai tên đăng nhập hoặc mật khẩu'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="640" as="sourcePoint" />
            <mxPoint x="500" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc02_resident_login_msg_else_2" parent="1" value="6b. Hiển thị thông báo lỗi 'Đăng nhập thất bại' &amp; Xóa trống mật khẩu" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="690" as="sourcePoint" />
            <mxPoint x="170" y="690" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uc03_resident_register_vehicle" name="[Cư Dân] UC03 - Đăng ký xe &amp; Chọn ô đỗ Cinema">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="980" math="0" shadow="0">
      <root>
