        <mxCell id="uc12_admin_approve_transfer_msg_happy_5" parent="1" value="9a. Đổi huy hiệu đơn sang màu xanh 'ĐÃ DUYỆT' &amp; Cập nhật danh mục xe" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
