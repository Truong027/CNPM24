        <mxCell id="uc08_guard_auto_checkin_msg_else_1" parent="1" value="6b. Giữ nguyên Barrier đóng &amp; Bật cờ cảnh báo an ninh cần kiểm tra thủ công" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
