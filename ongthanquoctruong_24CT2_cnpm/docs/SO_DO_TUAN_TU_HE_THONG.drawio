        <mxCell id="uc11_admin_user_mgmt_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Thao tác hợp lệ (Không tự khóa tài khoản Root Super Admin)]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=310;height=26;dashed=1;dashPattern=8 4;strokeColor=#4338CA;fillColor=#EEF2FF;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#1E1B4B;" vertex="1">
