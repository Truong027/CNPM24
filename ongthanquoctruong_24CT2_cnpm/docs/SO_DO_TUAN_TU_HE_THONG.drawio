        <mxCell id="uc03_resident_register_vehicle_msg_happy_3" parent="1" value="7a. Xác nhận lưu xe và đặt chỗ ô đỗ thành công" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
