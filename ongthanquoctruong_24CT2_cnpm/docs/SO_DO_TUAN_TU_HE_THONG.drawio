        <mxCell id="uc10_guard_collect_fee_barrier_msg_init_2" parent="1" value="2. POST /api/guard/collect_fee (session_id: 105, amount: 20000, method: 'Cash')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
