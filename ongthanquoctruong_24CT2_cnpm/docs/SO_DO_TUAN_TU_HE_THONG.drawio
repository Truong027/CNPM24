        <mxCell id="uc11_admin_user_mgmt_msg_init_2" parent="1" value="2. POST /api/admin/users/update (user_id: 5, role: 'Operator', status: 'active')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
