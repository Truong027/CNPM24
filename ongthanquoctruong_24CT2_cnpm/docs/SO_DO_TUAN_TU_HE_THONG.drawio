        </mxCell>
        <mxCell id="uc03_resident_register_vehicle_msg_init_2" parent="1" value="2. POST /api/resident/register_vehicle (plate: '30H-999.88', slot_id: 'B1-A01', months: 3)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
