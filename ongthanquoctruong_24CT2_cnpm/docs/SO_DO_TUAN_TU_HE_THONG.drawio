            <mxPoint x="1160" y="365" as="sourcePoint" />
            <mxPoint x="820" y="365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc01_register_msg_5" parent="1" value="5. Băm mật khẩu an toàn PBKDF2/SHA-256 (generate_password_hash)" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry" x="0" y="0">
            <mxPoint x="820" y="420" as="sourcePoint" />
            <mxPoint x="820" y="445" as="targetPoint" />
            <Array as="points">
              <mxPoint x="865" y="420" />
              <mxPoint x="865" y="445" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc01_register_msg_6" parent="1" value="6. INSERT INTO app_users &amp; cu_dan (MaCuDan, HoTen, TenDangNhap...)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="475" as="sourcePoint" />
            <mxPoint x="1160" y="475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc01_register_msg_7" parent="1" value="7. Xác nhận ghi bản ghi thành công (Affected rows = 1)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160" y="530" as="sourcePoint" />
            <mxPoint x="820" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc01_register_msg_8" parent="1" value="8. Phản hồi JSON: {success: true, message: 'Đăng ký thành công'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
