          </mxGeometry>
        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_msg_else_2" parent="1" value="4b. Giữ nguyên Barrier đóng, tiếp tục hiển thị chờ thanh toán" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#B91C1C;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=10;" edge="1">
