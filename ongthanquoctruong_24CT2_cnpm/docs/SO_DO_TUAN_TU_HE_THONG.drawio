        <mxCell id="uc10_collect_fee_barrier_msg_7" parent="1" value="7. Phản hồi JSON: {success: true, invoice_code: 'HD-20261002-01', barrier: 'OPEN'}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
