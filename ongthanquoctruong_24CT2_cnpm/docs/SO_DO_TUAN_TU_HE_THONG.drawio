            <mxPoint x="820" y="555" as="targetPoint" />
            <Array as="points">
              <mxPoint x="865" y="530" />
              <mxPoint x="865" y="555" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_checkout_verification_msg_8" parent="1" value="8. Phản hồi JSON: {verification_data, fee: 0, is_blacklist: false}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="585" as="sourcePoint" />
            <mxPoint x="475" y="585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_checkout_verification_msg_9" parent="1" value="9. Hiển thị song song 2 ảnh [Ảnh Vào] vs [Ảnh Ra Thực Tế] &amp; Hộp tính phí" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="475" y="640" as="sourcePoint" />
            <mxPoint x="180" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
