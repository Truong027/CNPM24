        <mxCell id="uc10_guard_collect_fee_barrier_msg_happy_3" parent="1" value="5a. Xác nhận ghi nhận doanh thu và kết thúc phiên gửi xe" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=10;" edge="1">
