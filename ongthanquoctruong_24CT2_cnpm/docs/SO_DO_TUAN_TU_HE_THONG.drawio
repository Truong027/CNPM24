        <mxCell id="uc05_renew_pass_msg_6" parent="1" value="6. UPDATE phuong_tien &amp; vehicles SET NgayHetHan = %s WHERE BienSoXe = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
