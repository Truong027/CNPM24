          <mxGeometry x="1040" y="60" width="240" height="750" as="geometry" />
        </mxCell>
        <mxCell id="uc09_checkout_verification_msg_1" parent="1" value="1. Camera cổng ra phát hiện xe hoặc Bảo vệ click chọn xe chuẩn bị ra" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="200" as="sourcePoint" />
            <mxPoint x="475" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_checkout_verification_msg_2" parent="1" value="2. GET /api/guard/verification/51G-123.45" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="475" y="255" as="sourcePoint" />
            <mxPoint x="820" y="255" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_checkout_verification_msg_3" parent="1" value="3. Truy vấn phiên đỗ: SELECT * FROM parking_sessions WHERE plate_text = %s AND status = 'Parked'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="310" as="sourcePoint" />
            <mxPoint x="1160" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_checkout_verification_msg_4" parent="1" value="4. Truy vấn loại xe: SELECT group_type, monthly_ticket_expiry FROM vehicles WHERE plate_text = %s" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="365" as="sourcePoint" />
            <mxPoint x="1160" y="365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_checkout_verification_msg_5" parent="1" value="5. Trả về thông tin phiên vào, ảnh snapshot vào, nhóm xe, hạn vé tháng" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160" y="420" as="sourcePoint" />
            <mxPoint x="820" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_checkout_verification_msg_6" parent="1" value="6. Tính thời gian đỗ, tính cước phí (Vé tháng = 0đ, Vãng lai = theo block giờ)" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry" x="0" y="0">
            <mxPoint x="820" y="475" as="sourcePoint" />
            <mxPoint x="820" y="500" as="targetPoint" />
            <Array as="points">
              <mxPoint x="865" y="475" />
              <mxPoint x="865" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="uc09_checkout_verification_msg_7" parent="1" value="7. Kiểm tra Blacklist: Nếu group_type = 'Blacklist' -&gt; Bật cờ cảnh báo an ninh" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;" edge="1">
          <mxGeometry relative="1" as="geometry" x="0" y="0">
