            <mxPoint x="920" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc07_resident_history_msg_init_3" parent="1" value="3. SELECT * FROM parking_sessions WHERE plate_text = %s ORDER BY check_in_time DESC" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10.5;" edge="1">
