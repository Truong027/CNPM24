        <mxCell id="uc10_guard_collect_fee_barrier_alt_frame" parent="1" value="&lt;b&gt;alt&lt;/b&gt; [Xác nhận thu phí thành công (Tiền mặt hoặc Chuyển khoản QR)]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=340;height=26;dashed=1;dashPattern=8 4;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#0F172A;" vertex="1">
          <mxGeometry x="90" y="310" width="1200" height="500" as="geometry" />
        </mxCell>
        <mxCell id="uc10_guard_collect_fee_barrier_msg_happy_1" parent="1" value="3a. UPDATE parking_sessions SET status = 'Completed', check_out_time = NOW(), fee = 20000" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
