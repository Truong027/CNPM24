            <mxPoint x="1160" y="365" as="sourcePoint" />
            <mxPoint x="820" y="365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uc05_renew_pass_msg_5" parent="1" value="5. Cộng dồn thời hạn mới (new_expiry = max(current_expiry, today) + months)" style="html=1;align=left;spacingLeft=5;verticalAlign=top;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;" edge="1">
