{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/get_plates", "destination": "/api/index.js" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/public-dashboard", "destination": "/public_dashboard.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/forgot-password", "destination": "/forgot_password.html" },
    { "source": "/reset-password", "destination": "/reset_password.html" },
    { "source": "/resident-dashboard", "destination": "/resident_dashboard.html" },
    { "source": "/operations-dashboard", "destination": "/operations_dashboard.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
