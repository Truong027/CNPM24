' ==============================================================================
' BIỂU ĐỒ HOẠT ĐỘNG TÁC NHÂN CU_DAN (CHUẨN CÚ PHÁP IF / ELSE / ENDIF PLANTUML)
' ĐẦY ĐỦ 7 USE CASES TỪ USERCASE.PPTX - GỌN GÀNG, ĐẸP, KHÔNG RỐI
' ==============================================================================

' ------------------------------------------------------------------------------
' 1. SƠ ĐỒ HOẠT ĐỘNG TỔNG HỢP TẤT CẢ CHỨC NĂNG CỦA CƯ DÂN (MASTER FLOW)
' ------------------------------------------------------------------------------
@startuml Activity_Cu_dan_TongHop
start
:Cư dân;
:Truy cập Cổng dịch vụ Cư dân;

if (Đã có tài khoản?) then (chưa)
  :Nhập thông tin đăng ký căn hộ mới;
  if (Thông tin hợp lệ & chưa tồn tại?) then (đúng)
    :Hệ thống kích hoạt tài khoản;
  else (sai / trùng)
    :Báo lỗi trùng tài khoản hoặc SĐT;
  endif
else (rồi)
endif

:Đăng nhập tài khoản Cư dân;

if (Xác thực đăng nhập thành công?) then (đúng)
  :Truy cập Cổng Cư Dân (Resident Dashboard);

  if (Chức năng lựa chọn?) then (Đăng ký xe mới)
    :Khai báo biển số & Chọn vị trí ô đỗ Cinema;
    if (Biển số hợp lệ & Ô đỗ còn trống?) then (hợp lệ)
      :Lưu phương tiện & Cấp thẻ xe 3D;
    else (trùng / lỗi)
      :Báo lỗi trùng biển số hoặc ô đã có xe;
    endif

  else if (Đổi vị trí ô đỗ) then (đúng)
    :Xem sơ đồ 100 ô & Chọn vị trí mới;
    if (Vị trí mới đang trống?) then (hợp lệ)
      :Cập nhật vị trí mới & Giải phóng ô cũ;
    else (đã có xe)
      :Báo lỗi vị trí ô đỗ đã có xe khác;
    endif

  else if (Gia hạn vé tháng) then (đúng)
    :Chọn xe & Gói thời hạn (1, 3, 6 tháng);
    if (Thanh toán phí dịch vụ thành công?) then (thành công)
      :Hệ thống cộng dồn ngày hết hạn vé xe;
    else (thất bại / hủy)
      :Hủy giao dịch & Giữ nguyên hạn vé;
    endif

  else if (Chuyển nhượng xe) then (đúng)
    :Lập đơn chuyển nhượng & Nhập căn hộ nhận;
    if (Căn hộ nhận tồn tại và hợp lệ?) then (hợp lệ)
      :Ghi nhận đơn chờ Ban Quản Lý duyệt;
    else (không tồn tại)
      :Báo lỗi mã căn hộ nhận không đúng;
    endif

  else (Tra cứu lịch sử)
    :Tra cứu danh sách xe ra/vào của căn hộ;
    if (Có dữ liệu lượt xe ra/vào?) then (có)
      :Hiển thị chi tiết thời gian & ảnh chụp;
    else (trống)
      :Thông báo chưa có dữ liệu gửi xe;
    endif
  endif

  :Cư dân đăng xuất khỏi hệ thống;
else (sai)
  :Hiển thị thông báo sai thông tin đăng nhập;
endif

stop
@enduml


' ------------------------------------------------------------------------------
' 2. CHI TIẾT TỪNG USE CASE THEO ĐÚNG HÌNH MẪU IF - ELSE ĐƠN GIẢN
' ------------------------------------------------------------------------------

' --- USE CASE 1: ĐĂNG KÝ TÀI KHOẢN ---
@startuml UC1_Dang_ky_tai_khoan
start
:Nhập thông tin cư dân (Họ tên, SĐT, Căn hộ, Mật khẩu);
if (Thông tin hợp lệ & Chưa tồn tại?) then (đúng)
  :Tạo tài khoản Cư dân mới;
  :Thông báo đăng ký thành công;
else (sai)
  :Hiển thị thông báo lỗi trùng lặp;
  :Yêu cầu kiểm tra lại thông tin;
endif
stop
@enduml

' --- USE CASE 2: ĐĂNG NHẬP & ĐỔI MẬT KHẨU ---
@startuml UC2_Dang_nhap_va_doi_mat_khau
start
:Nhập tên tài khoản & mật khẩu;
if (Thông tin chính xác & Tài khoản hoạt động?) then (đúng)
  :Đăng nhập thành công;
  :Chuyển hướng vào Resident Dashboard;
else (sai)
  :Báo sai mật khẩu hoặc tài khoản bị khóa;
  :Yêu cầu đăng nhập lại;
endif
stop
@enduml

' --- USE CASE 3: ĐĂNG KÝ XE & CHỌN Ô ĐỖ ---
@startuml UC3_Dang_ky_xe_va_chon_o_do
start
:Nhập biển số xe & Mở sơ đồ bãi đỗ Cinema;
:Chọn vị trí ô đỗ còn trống;
if (Biển số hợp lệ & Vị trí ô đỗ còn trống?) then (đúng)
  :Lưu thông tin phương tiện;
  :Giữ vị trí ô đỗ trên sơ đồ Cinema;
  :Hiển thị Thẻ xe 3D trên giao diện;
else (sai)
  :Báo lỗi trùng biển số hoặc ô đỗ đã có xe;
  :Yêu cầu chọn lại vị trí khác;
endif
stop
@enduml

' --- USE CASE 4: ĐỔI VỊ TRÍ Ô ĐỖ CINEMA ---
@startuml UC4_Doi_vi_tri_o_do_Cinema
start
:Mở sơ đồ bãi đỗ 100 ô (Hầm B1 / B2);
:Chọn vị trí ô đỗ mới;
if (Vị trí mới đang trống (Màu xanh)?) then (đúng)
  :Cập nhật xe sang vị trí ô đỗ mới;
  :Giải phóng ô đỗ cũ về trạng thái trống;
  :Thông báo đổi vị trí thành công;
else (sai)
  :Báo vị trí đã có xe khác đăng ký;
  :Yêu cầu chọn vị trí khác;
endif
stop
@enduml

' --- USE CASE 5: GIA HẠN VÉ THÁNG ---
@startuml UC5_Gia_han_ve_thang
start
:Chọn phương tiện & Gói thời hạn (1, 3, 6 tháng);
:Xác nhận thanh toán phí dịch vụ;
if (Thanh toán phí thành công?) then (đúng)
  :Cộng dồn thời hạn vé tháng;
  :Cập nhật trạng thái thẻ xe hợp lệ;
  :Gửi thông báo gia hạn thành công;
else (sai)
  :Hủy giao dịch gia hạn;
  :Giữ nguyên thời hạn vé cũ;
endif
stop
@enduml

' --- USE CASE 6: YÊU CẦU CHUYỂN NHƯỢNG XE ---
@startuml UC6_Yeu_cau_chuyen_nhuong_xe
start
:Chọn xe cần chuyển & Nhập mã căn hộ nhận;
if (Căn hộ nhận hợp lệ & Xe không có vi phạm?) then (đúng)
  :Tạo đơn chuyển nhượng trạng thái 'Pending';
  :Gửi thông báo chờ Ban Quản Lý phê duyệt;
else (sai)
  :Báo thông tin căn hộ nhận không hợp lệ;
  :Hủy yêu cầu chuyển nhượng;
endif
stop
@enduml

' --- USE CASE 7: TRA CỨU LỊCH SỬ VÀO RA ---
@startuml UC7_Tra_cuu_lich_su_vao_ra
start
:Chọn khoảng thời gian cần xem lịch sử;
if (Có dữ liệu lịch sử xe vào / ra?) then (có)
  :Hiển thị danh sách các phiên gửi xe;
  :Xem chi tiết thời gian & ảnh chụp đối chiếu;
else (không)
  :Thông báo chưa có lượt xe nào trong khoảng thời gian này;
endif
stop
@enduml


' ==============================================================================
' BIỂU ĐỒ HOẠT ĐỘNG TÁC NHÂN QUAN_TRI_VIEN (CHUẨN CÚ PHÁP IF / ELSE / ENDIF)
' ĐẦY ĐỦ 8 USE CASES TỪ USERCASE.PPTX - GỌN GÀNG, ĐẸP, KHÔNG RỐI
' ==============================================================================

' ------------------------------------------------------------------------------
' 1. SƠ ĐỒ HOẠT ĐỘNG TỔNG HỢP CỦA QUẢN TRỊ VIÊN (MASTER FLOW)
' ------------------------------------------------------------------------------
@startuml Activity_Quan_tri_vien_TongHop
start
:Quản trị viên;
:Đăng nhập tài khoản Quản trị viên (Admin);

if (Xác thực quyền Admin thành công?) then (đúng)
  :Truy cập Bảng điều khiển Quản trị (Admin Console);

  if (Phân hệ quản trị?) then (Quản lý người dùng)
    :Xem danh sách tài khoản & Thực hiện thao tác;
    if (Thông tin người dùng hợp lệ?) then (hợp lệ)
      :Lưu tài khoản & Đồng bộ CSDL (app_users, cu_dan, nhan_vien);
    else (trùng / lỗi)
      :Báo lỗi trùng tên tài khoản hoặc thiếu thông tin;
    endif

  else if (Quản lý xe & Phân nhóm) then (đúng)
    :Cập nhật danh mục & Gán nhãn xe (Normal/White/Blacklist);
    if (Biển số xe hợp lệ?) then (hợp lệ)
      :Cập nhật thông tin & Thiết lập nhóm an ninh cho xe;
    else (lỗi / trùng)
      :Báo lỗi biển số không đúng định dạng hoặc đã tồn tại;
    endif

  else if (Quản lý sơ đồ bãi đỗ) then (đúng)
    :Xem sơ đồ bãi đỗ Cinema 100 ô (Hầm B1 / B2);
    if (Vị trí ô đỗ còn trống?) then (trống)
      :Chỉ định cấp phát ô đỗ & Đổi trạng thái 'Đã có xe';
    else (đã có xe)
      :Thu hồi quyền đỗ hoặc báo lỗi ô đỗ đã bị chiếm;
    endif

  else if (Duyệt chuyển nhượng xe) then (đúng)
    :Xem danh sách đơn chuyển nhượng đang chờ (Pending);
    if (Hồ sơ chuyển nhượng hợp lệ?) then (chấp thuận)
      :Chuyển quyền sở hữu xe sang căn hộ nhận & Duyệt 'Approved';
    else (từ chối)
      :Nhập lý do từ chối & Cập nhật đơn thành 'Rejected';
    endif

  else if (Thử nghiệm nhận diện AI) then (đúng)
    :Tải file ảnh chụp xe lên hệ thống;
    if (Mô hình AI phát hiện được biển số?) then (thành công)
      :Vẽ Bounding Box & Hiển thị chuỗi ký tự nhận diện;
    else (thất bại)
      :Báo lỗi không tìm thấy biển số trong ảnh tải lên;
    endif

  else (Báo cáo & Thống kê)
    :Chọn khoảng thời gian thống kê doanh thu;
    if (Có dữ liệu giao dịch trong kỳ?) then (có dữ liệu)
      :Hiển thị biểu đồ KPI, giờ cao điểm & Xuất file Excel;
    else (trống)
      :Thông báo chưa có dữ liệu gửi xe trong khoảng thời gian này;
    endif
  endif

  :Quản trị viên đăng xuất khỏi hệ thống;
else (sai)
  :Hiển thị thông báo sai mật khẩu hoặc không có quyền Admin;
endif

stop
@enduml


' ------------------------------------------------------------------------------
' 2. CHI TIẾT TỪNG USE CASE THEO ĐÚNG HÌNH MẪU IF - ELSE ĐƠN GIẢN
' ------------------------------------------------------------------------------

' --- USE CASE 1: QUẢN LÝ NGƯỜI DÙNG ---
@startuml UC_Admin_Quan_ly_nguoi_dung
start
:Mở danh sách tài khoản người dùng;
:Chọn tài khoản cần thao tác;

if (Thao tác thực hiện?) then (Cấp tài khoản mới)
  :Nhập thông tin nhân viên hoặc cư dân mới;
  :Hệ thống mã hóa mật khẩu & tạo tài khoản;
else if (Khóa / Mở khóa) then (đúng)
  :Thay đổi trạng thái tài khoản;
  :Hệ thống cập nhật quyền truy cập;
else (Đặt lại mật khẩu)
  :Nhập mật khẩu mới cho người dùng;
  :Hệ thống cập nhật mật khẩu mới;
endif

stop
@enduml

' --- USE CASE 2: QUẢN LÝ DANH MỤC XE & PHÂN NHÓM ---
@startuml UC_Admin_Quan_ly_danh_muc_xe
start
:Tra cứu danh sách phương tiện trong bãi;
:Chọn phương tiện cần cập nhật;

if (Loại thao tác?) then (Cập nhật thông tin)
  :Chỉnh sửa chủ xe, loại xe, màu sắc;
  :Hệ thống cập nhật thông tin phương tiện;
else if (Phân nhóm xe) then (đúng)
  :Gán nhãn Normal, Whitelist hoặc Blacklist;
  :Hệ thống thiết lập cơ chế an ninh & cước phí;
else (Xóa phương tiện)
  :Xác nhận xóa xe khỏi hệ thống;
  :Hệ thống giải phóng ô đỗ & xóa dữ liệu xe;
endif

stop
@enduml

' --- USE CASE 3: QUẢN LÝ SƠ ĐỒ BÃI ĐỖ CINEMA ---
@startuml UC_Admin_Quan_ly_so_do_bai_do
start
:Mở sơ đồ bãi đỗ Cinema 100 ô (Hầm B1 / B2);
:Theo dõi tỷ lệ lấp đầy & trạng thái ô đỗ;

if (Ô đỗ đang chọn?) then (Đang trống)
  :Chỉ định cấp phát ô đỗ cho xe mới;
  :Chuyển trạng thái ô đỗ sang 'Đã có xe';
else (Đang có xe)
  :Thu hồi quyền đỗ xe tại vị trí này;
  :Chuyển trạng thái ô đỗ về 'Trống';
endif

stop
@enduml

' --- USE CASE 4: PHÊ DUYỆT CHUYỂN NHƯỢNG XE ---
@startuml UC_Admin_Phe_duyet_chuyen_nhuong_xe
start
:Mở danh sách đơn chuyển nhượng đang chờ (Pending);
:Kiểm tra thông tin chủ cũ và căn hộ nhận;

if (Đơn hợp lệ & Đủ điều kiện?) then (chấp thuận)
  :Chuyển quyền sở hữu xe sang căn hộ nhận;
  :Đồng bộ thông tin chủ xe và thẻ vé tháng;
  :Cập nhật trạng thái đơn thành 'Approved';
else (từ chối)
  :Nhập lý do từ chối yêu cầu;
  :Cập nhật trạng thái đơn thành 'Rejected';
endif

stop
@enduml

' --- USE CASE 5: THỬ NGHIỆM NHẬN DIỆN AI QUA ẢNH ---
@startuml UC_Admin_Thu_nghiem_nhan_dien_AI
start
:Tải file ảnh chụp xe lên hệ thống;
:Hệ thống chạy mô hình YOLOv8 + CRNN;

if (Mô hình phát hiện được biển số?) then (có)
  :Vẽ khung chữ nhật Bounding Box quanh biển;
  :Hiển thị chuỗi ký tự nhận diện & độ tin cậy;
else (không)
  :Báo không tìm thấy biển số trong ảnh;
  :Yêu cầu tải ảnh rõ nét hơn;
endif

stop
@enduml

' --- USE CASE 6: BÁO CÁO DOANH THU & XUẤT EXCEL ---
@startuml UC_Admin_Bao_cao_doanh_thu_va_xuat_Excel
start
:Chọn khoảng thời gian thống kê (ngày / tháng);
:Hệ thống tổng hợp dữ liệu doanh thu & giờ cao điểm;

if (Yêu cầu xuất file?) then (có)
  :Xuất dữ liệu thống kê ra file Excel / CSV;
  :Tải file báo cáo về máy tính;
else (không)
  :Xem biểu đồ phân tích trực quan trên Dashboard;
endif

stop
@enduml


' ==============================================================================
' BIỂU ĐỒ HOẠT ĐỘNG TÁC NHÂN BAO_VE (CHUẨN CÚ PHÁP IF / ELSE / ENDIF)
' ĐẦY ĐỦ 8 USE CASES TỪ USERCASE.PPTX - GỌN GÀNG, ĐẸP, KHÔNG RỐI
' ==============================================================================

' ------------------------------------------------------------------------------
' 1. SƠ ĐỒ HOẠT ĐỘNG TỔNG HỢP CỦA BẢO VỆ (MASTER FLOW)
' ------------------------------------------------------------------------------
@startuml Activity_Bao_ve_TongHop
start

:Đăng nhập tài khoản Nhân viên bảo vệ;

if (Xác thực tài khoản thành công?) then (đúng)
  :Mở giao diện Bàn trực bốt gác;
  :Giám sát camera cổng trực tiếp;

  :Xe tiến vào vùng quét camera;

  if (Camera quét được biển số?) then (có)
    :Tự động nhận diện biển số (YOLOv8 + CRNN);
  else (không / biển mờ)
    :Nhập biển số thủ công (Manual Entry);
  endif

  if (Xe thuộc danh sách đen Blacklist?) then (đúng)
    :Bật còi báo động đỏ & Khóa barrier;
    :Từ chối cho xe qua cổng & Giữ xe kiểm tra;
  else (hợp lệ)
    if (Làn xe kiểm soát?) then (Làn vào - Check-in)
      :Chụp ảnh snapshot xe lúc vào;
      :Tạo phiên gửi xe mới (status: 'Parked');
      :Kích hoạt mở Barrier cổng vào;
      :Cho xe vào bãi an toàn;
    else (Làn ra - Check-out)
      :Hiển thị đối chiếu ảnh Vào - Ra Side-by-Side;
      :Hệ thống tự động tính cước phí;

      if (Xe vé tháng cư dân?) then (đúng)
        :Miễn phí vé (0 VNĐ);
      else (vãng lai)
        :Thu tiền cước theo giờ;
      endif

      :Bấm [Xác nhận thu phí & Mở Barrier];
      :Hoàn tất phiên gửi xe & In hóa đơn;
      :Mở Barrier cổng ra cho xe qua;
    endif
  endif

  :Bảo vệ bàn giao ca & Đăng xuất;
else (sai)
  :Báo lỗi đăng nhập tài khoản bảo vệ;
endif

stop
@enduml


' ------------------------------------------------------------------------------
' 2. CHI TIẾT TỪNG USE CASE THEO ĐÚNG HÌNH MẪU IF - ELSE ĐƠN GIẢN
' ------------------------------------------------------------------------------

' --- USE CASE 1: NHẬN DIỆN BIỂN SỐ TỰ ĐỘNG ---
@startuml UC_Guard_Nhan_dien_bien_so
start
:Camera thu nhận luồng video cổng vào / ra;
:Mô hình AI phát hiện và quét biển số xe;

if (Độ tin cậy nhận diện >= 80%?) then (đạt)
  :Nhận diện chuỗi ký tự biển số tự động;
  :Hiển thị biển số lên màn hình bàn trực;
else (chưa đạt)
  :Kích hoạt EasyOCR nhận diện dự phòng;
  :Cho phép bảo vệ sửa lại hoặc nhập thủ công;
endif

stop
@enduml

' --- USE CASE 2: KIỂM SOÁT XE VÀO RA ---
@startuml UC_Guard_Kiem_soat_xe_vao_ra
start
:Xe dừng trước cổng kiểm soát bốt gác;
:Hệ thống xác định làn xe vào hoặc ra;

if (Làn xe di chuyển?) then (Làn vào)
  :Chụp ảnh xe & Ghi nhận giờ vào;
  :Tạo phiên đỗ mới trong hệ thống;
  :Kích hoạt mở Barrier cổng vào;
else (Làn ra)
  :Tìm phiên đỗ xe đang mở;
  :Tính thời lượng đỗ và số tiền cước;
  :Chuyển sang bước đối chiếu ảnh và thu phí;
endif

stop
@enduml

' --- USE CASE 3: ĐỐI CHIẾU ẢNH VÀO RA ---
@startuml UC_Guard_Doi_chieu_anh_vao_ra
start
:Xe tiến vào làn ra bãi đỗ;
:Hệ thống truy xuất ảnh chụp lúc vào;
:Hiển thị song song 2 ảnh: Ảnh Vào vs Ảnh Ra;

if (Biển số và loại xe trùng khớp?) then (khớp)
  :Xác nhận phương tiện hợp lệ;
  :Tiến hành bước thu phí gửi xe;
else (không khớp)
  :Cảnh báo nghi vấn đánh tráo biển số;
  :Giữ xe để bảo vệ kiểm tra thực tế;
endif

stop
@enduml

' --- USE CASE 4: NHẬP BIỂN SỐ THỦ CÔNG ---
@startuml UC_Guard_Nhap_bien_so_thu_cong
start
:Camera không đọc được do biển mờ hoặc bẩn;
:Bảo vệ mở hộp thoại nhập thủ công;
:Gõ biển số xe trực tiếp từ bàn phím;

if (Biển số xe nhập đúng định dạng?) then (hợp lệ)
  :Lưu biển số và tiếp tục xử lý xe vào / ra;
  :Ghi nhận lý do nhập thủ công vào nhật ký;
else (không hợp lệ)
  :Báo định dạng biển số không đúng;
  :Yêu cầu bảo vệ kiểm tra và nhập lại;
endif

stop
@enduml

' --- USE CASE 5: XỬ LÝ CẢNH BÁO XE BLACKLIST ---
@startuml UC_Guard_Xu_ly_canh_bao_Blacklist
start
:Hệ thống tra cứu biển số trong danh mục xe;

if (Xe thuộc danh sách đen Blacklist?) then (phát hiện)
  :Kích hoạt chuông còi báo động khẩn cấp;
  :Bật khung cảnh báo màu đỏ trên màn hình;
  :Khóa hoàn toàn nút bấm mở Barrier;
  :Bảo vệ giữ xe và liên hệ cơ quan an ninh;
else (không vi phạm)
  :Cho phép tiếp tục quy trình qua cổng bình thường;
endif

stop
@enduml

' --- USE CASE 6: THU PHÍ & MỞ BARRIER ---
@startuml UC_Guard_Thu_phi_va_mo_Barrier
start
:Tính số tiền cước phí gửi xe;

if (Phương thức gửi xe?) then (Vé tháng cư dân còn hạn)
  :Số tiền cần thu hiển thị 0 VNĐ;
  :Bảo vệ bấm mở Barrier cho xe ra;
else (Xe vãng lai)
  :Hiển thị số tiền cước theo giờ đỗ;
  :Bảo vệ thu tiền mặt hoặc quét mã QR;
  :Bấm [Xác nhận thu tiền & Mở Barrier];
  :Hệ thống tạo mã hóa đơn điện tử HD-XXXXXX;
  :Kích hoạt mở Barrier cổng ra tự động;
endif

stop
@enduml


